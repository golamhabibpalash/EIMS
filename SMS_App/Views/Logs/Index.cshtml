@using SMS_App.Utilities.Pagination;
@using SMS_App.ViewModels.LogVM

@model PaginatedList<ActivityLogVM>
@{
    ViewData["Title"] = "Activity Logs";
    int pageSize = 50;
    if (ViewData["PageSize"] != null && int.TryParse(ViewData["PageSize"].ToString(), out var parsedPageSize))
    {
        pageSize = parsedPageSize;
    }
    int totalData = 0;
    if (ViewData["TotalData"] != null && int.TryParse(ViewData["TotalData"].ToString(), out var parsedTotalData))
    {
        totalData = parsedTotalData;
    }
    int sl = (Model.PageIndex - 1) * pageSize + 1;
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-12">
            <h2>Activity Logs</h2>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="row mb-3">
        <div class="col-md-12">
            <form asp-action="Index" method="get" class="form-inline">
                <div class="row g-3 align-items-end w-100">
                    <div class="col-md-4">
                        <label for="searchText" class="form-label">Search</label>
                        <input type="text"
                               name="searchText"
                               value="@ViewData["CurrentFilter"]"
                               class="form-control"
                               placeholder="Search by message, level, or exception..." />
                    </div>
                    <div class="col-md-3">
                        <label for="pageSize" class="form-label">Items per page</label>
                        <select name="pageSize" class="form-select">
                            <option value="10" selected="@(ViewData["PageSize"]?.ToString() == "10")">10</option>
                            <option value="25" selected="@(ViewData["PageSize"]?.ToString() == "25")">25</option>
                            <option value="50" selected="@(ViewData["PageSize"]?.ToString() == "50")">50</option>
                            <option value="100" selected="@(ViewData["PageSize"]?.ToString() == "100")">100</option>
                        </select>
                    </div>
                    <div class="col-md-5">
                        <input type="hidden" name="sortOrder" value="@ViewData["CurrentSort"]" />
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="bi bi-search"></i> Search
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-counterclockwise"></i> Reset
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Results Info -->
    <div class="row mb-2">
        <div class="col-md-12">
            <p class="text-muted">
                Showing @((Model.PageIndex - 1) * pageSize + 1)
                to @Math.Min(Model.PageIndex * pageSize, totalData)
                of @totalData entries
                @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
                {
                    <span>(filtered from total entries)</span>
                }
            </p>
        </div>
    </div>

    <!-- Table -->
    <div class="row">
        <div class="col-md-12">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>
                                <a asp-action="Index"
                                   asp-route-sortOrder="@ViewData["DateSort"]"
                                   asp-route-searchText="@ViewData["CurrentFilter"]"
                                   asp-route-pageSize="@ViewData["PageSize"]"
                                   class="text-white text-decoration-none">
                                    Timestamp
                                    @if (ViewData["CurrentSort"]?.ToString() == "date_asc")
                                    {
                                        <i class="bi bi-arrow-up"></i>
                                    }
                                    else if (ViewData["CurrentSort"]?.ToString() == "date_desc")
                                    {
                                        <i class="bi bi-arrow-down"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index"
                                   asp-route-sortOrder="@ViewData["LevelSort"]"
                                   asp-route-searchText="@ViewData["CurrentFilter"]"
                                   asp-route-pageSize="@ViewData["PageSize"]"
                                   class="text-white text-decoration-none">
                                    Level
                                    @if (ViewData["CurrentSort"]?.ToString() == "level_asc")
                                    {
                                        <i class="bi bi-arrow-up"></i>
                                    }
                                    else if (ViewData["CurrentSort"]?.ToString() == "level_desc")
                                    {
                                        <i class="bi bi-arrow-down"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index"
                                   asp-route-sortOrder="@ViewData["MessageSort"]"
                                   asp-route-searchText="@ViewData["CurrentFilter"]"
                                   asp-route-pageSize="@ViewData["PageSize"]"
                                   class="text-white text-decoration-none">
                                    Message
                                    @if (ViewData["CurrentSort"]?.ToString() == "message_asc")
                                    {
                                        <i class="bi bi-arrow-up"></i>
                                    }
                                    else if (ViewData["CurrentSort"]?.ToString() == "message_desc")
                                    {
                                        <i class="bi bi-arrow-down"></i>
                                    }
                                </a>
                            </th>
                            <th>Template</th>
                            <th>Properties</th>
                            <th>Exception</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    No activity logs found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var log in Model)
                            {
                                <tr>
                                    <td>@sl</td>
                                    <td>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss tt")</td>
                                    <td>
                                        <span class="badge bg-@(GetLevelBadgeClass(log.Level))">
                                            @log.Level
                                        </span>
                                    </td>
                                    <td>
                                        @if (log.Message.Length > 100)
                                        {
                                            <span title="@log.Message">
                                                @log.Message.Substring(0, 100)...
                                            </span>
                                        }
                                        else
                                        {
                                            @log.Message
                                        }
                                    </td>
                                    <td>
                                        @log.MessageTemplate
                                    </td>
                                    <td>
                                        @log.Properties
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(log.Exception))
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#exceptionModal"
                                                    onclick="showException('@Html.Raw(System.Text.Json.JsonSerializer.Serialize(log.Exception))')">
                                                View Exception
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                                sl++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="row">
            <div class="col-md-12">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        <!-- Previous Button -->
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pageIndex="@(Model.PageIndex - 1)"
                               asp-route-searchText="@ViewData["CurrentFilter"]"
                               asp-route-sortOrder="@ViewData["CurrentSort"]"
                               asp-route-pageSize="@ViewData["PageSize"]">
                                Previous
                            </a>
                        </li>

                        <!-- Page Numbers -->
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            @if (i == 1 || i == Model.TotalPages || (i >= Model.PageIndex - 2 && i <= Model.PageIndex + 2))
                            {
                                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-pageIndex="@i"
                                       asp-route-searchText="@ViewData["CurrentFilter"]"
                                       asp-route-sortOrder="@ViewData["CurrentSort"]"
                                       asp-route-pageSize="@ViewData["PageSize"]">
                                        @i
                                    </a>
                                </li>
                            }
                            else if (i == Model.PageIndex - 3 || i == Model.PageIndex + 3)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                        }

                        <!-- Next Button -->
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pageIndex="@(Model.PageIndex + 1)"
                               asp-route-searchText="@ViewData["CurrentFilter"]"
                               asp-route-sortOrder="@ViewData["CurrentSort"]"
                               asp-route-pageSize="@ViewData["PageSize"]">
                                Next
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }
</div>

<!-- Exception Modal -->
<div class="modal fade" id="exceptionModal" tabindex="-1" aria-labelledby="exceptionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exceptionModalLabel">Exception Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <pre id="exceptionContent" style="white-space: pre-wrap; word-wrap: break-word;"></pre>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showException(exception) {
            document.getElementById('exceptionContent').textContent = exception;
        }
    </script>
}

@functions {
    string GetLevelBadgeClass(string level)
    {
        return level?.ToLower() switch
        {
            "error" => "danger",
            "warning" => "warning",
            "information" => "info",
            "debug" => "secondary",
            _ => "primary"
        };
    }
}