@model AdmissionNoticeListVM
@{
    ViewData["Title"] = "Admission notices";
}
<div class="d-flex flex-wrap justify-content-between align-items-end mb-3 gap-2">
    <div>
        <h1 class="h3 mb-0">Admission notices</h1>
        <div class="text-muted">ভর্তি বিজ্ঞপ্তি</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Manual" class="btn btn-outline-primary"><i class="fa fa-book-open"></i> How to apply</a>
        <a asp-action="Track" class="btn btn-outline-secondary"><i class="fa fa-search"></i> Track application</a>
    </div>
</div>

@if (!Model.Notices.Any())
{
    <div class="card adm-card"><div class="card-body text-center text-muted py-5">
        There are no admission notices at the moment. Please check again later.<br />এই মুহূর্তে কোনো ভর্তি বিজ্ঞপ্তি নেই।
    </div></div>
}

<div class="row g-3">
    @foreach (var notice in Model.Notices)
    {
        var s = notice.Session;
        <div class="col-12 col-lg-6">
            <div class="card adm-card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <h2 class="h5 mb-1">
                            <a asp-action="Notice" asp-route-id="@s.Id" class="text-decoration-none stretched-link">@s.Title</a>
                        </h2>
                        <span class="badge @AdmissionDisplay.WindowBadge(notice.State)">@AdmissionDisplay.Name(notice.State)</span>
                    </div>
                    <div class="small text-muted mb-2">
                        Academic year @s.AcademicSession?.Name ·
                        Classes: @string.Join(", ", s.Programs.OrderBy(p => p.AcademicClass?.ClassSerial).Select(p => p.AcademicClass?.Name))
                    </div>
                    @if (!string.IsNullOrEmpty(s.NoticeSummary))
                    {
                        <p class="mb-2">@s.NoticeSummary</p>
                    }
                    <div class="mt-auto small">
                        <i class="fa fa-calendar"></i>
                        Apply @s.ApplicationStartDate.ToString("dd MMM yyyy") - <strong>@s.ApplicationEndDate.ToString("dd MMM yyyy")</strong>
                    </div>
                    <div class="mt-2">
                        <span class="btn btn-primary btn-sm">@(notice.State == AdmissionWindowState.Open || notice.State == AdmissionWindowState.ClosingSoon ? "Apply for admission" : "View admission details")</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
