@model SMS.Entities.AcademicSubject

@{
    ViewData["Title"] = "Create Subject";
    GlobalUI.PageTitle = ViewBag.Title;
}
<div class="row">
    <div class="col-md-6 offset-md-3">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group row">
                <label asp-for="SubjectName" class="control-label col-form-label col-md-2 text-md-end"></label>
                <div class="col-md-10">
                    <input asp-for="SubjectName" class="form-control" />
                    <span asp-validation-for="SubjectName" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="SubjectCode" class="control-label col-form-label col-md-2 text-md-end"></label>
                <div class="col-md-10">
                    <input asp-for="SubjectCode" class="form-control" placeholder="Ex: 103" />
                    <span asp-validation-for="SubjectCode" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="AcademicSubjectTypeId" class="control-label col-form-label col-md-2 text-md-end"></label>
                <div class="col-md-10 input-group">
                    <select asp-for="AcademicSubjectTypeId" class="form-control" asp-items="ViewBag.AcademicSubjectTypeId">
                        <option selected disabled>Select Subject Type</option>
                    </select>
                    <div>
                        <a class="btn btn-sm btn-outline-info" asp-action="Create" asp-controller="AcademicSubjectTypes"><i class="fa fa-plus"></i> Add</a>
                    </div>
                    <span asp-validation-for="AcademicSubjectTypeId" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="SubjectFor" class="control-label col-form-label col-md-2 text-md-end"></label>
                <div class="col-md-10">
                    <select asp-for="SubjectFor" class="form-control">
                        <option selected disabled>Select Subject For</option>
                        <option value="S">School</option>
                        <option value="C">College</option>
                    </select>
                    <span asp-validation-for="SubjectFor" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="AcademicClassId" class="control-label col-form-label col-md-2 text-md-end"></label>
                <div class="col-md-10">
                    <select asp-for="AcademicClassId" class="form-control" asp-items="ViewBag.AcademicClassId">
                        <option value="">Select Academic Class</option>
                    </select>
                    <span asp-validation-for="AcademicClassId" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="QuestionFormatId" class="control-label col-form-label col-md-2 text-md-end"></label>
                <div class="col-md-10">
                    <select asp-for="QuestionFormatId" class="form-control" asp-items="ViewBag.QuestionFormatId">
                        <option value="">Select Question Format</option>
                    </select>
                    <span asp-validation-for="QuestionFormatId" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="ReligionId" class="control-label col-form-label col-md-2 text-md-end"></label>
                <div class="col-md-10">
                    <select asp-for="ReligionId" class="form-control" asp-items="ViewBag.ReligionList">
                        <option value="">All Religion</option>
                    </select>
                    <span asp-validation-for="ReligionId" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="TotalMarks" class="control-label col-form-label col-md-2 text-md-end"></label>
                <div class="col-md-10">
                    <input asp-for="TotalMarks" class="form-control" />
                    <span asp-validation-for="TotalMarks" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <div class="offset-md-2 col-md-10">
                    <label>
                        <input asp-for="Status" /> @Html.DisplayNameFor(model => model.Status)
                    </label>
                </div>
            </div>
            <div class="form-group row">
                <div class="offset-md-2 col-md-10">
                    <partial name="_Create_Back" />
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        let deleted = '@TempData["deleted"]';
        let created = '@TempData["created"]';
        let updated = '@TempData["updated"]';
        let failed = '@TempData["error"]';
    </script>
    <script src="~/js/AlertifyNotify/AlertifyNofify.js"></script>
}
