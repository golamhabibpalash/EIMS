@model SMS_App.ViewModels.Notifications.NotificationListVM
@{
    ViewData["Title"] = "Notifications";
    GlobalUI.PageTitle = "Notifications";
}

@if (TempData["success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="h5 mb-0">
            Notifications
            @if (Model.UnreadCount > 0)
            {
                <span class="badge bg-danger ms-1">@Model.UnreadCount unread</span>
            }
        </span>
        @if (Model.UnreadCount > 0)
        {
            <form asp-action="MarkAllRead" method="post" class="mb-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-secondary">Mark all read</button>
            </form>
        }
    </div>
    <div class="list-group list-group-flush">
        @if (Model.Items.Count == 0)
        {
            <div class="list-group-item text-center text-muted py-4">
                You have no notifications.
            </div>
        }
        else
        {
            foreach (var item in Model.Items)
            {
                var hasLink = !string.IsNullOrWhiteSpace(item.Url);
                <a href="@(hasLink ? Url.Action("Open", new { id = item.Id }) : "#")"
                   class="list-group-item list-group-item-action @(item.IsRead ? "" : "bg-light")">
                    <div class="d-flex justify-content-between">
                        <span class="@(item.IsRead ? "" : "fw-bold")">
                            @if (!item.IsRead)
                            {
                                <span class="badge bg-primary rounded-pill me-1">&nbsp;</span>
                            }
                            @item.Title
                        </span>
                        <small class="text-muted">@item.CreatedAt.ToString("dd MMM yyyy HH:mm")</small>
                    </div>
                    <div class="text-muted small">@item.Message</div>
                </a>
            }
        }
    </div>
</div>
