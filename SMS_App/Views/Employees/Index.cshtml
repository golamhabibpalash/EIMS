
@model IEnumerable<SMS.Entities.Employee>


@inject UserManager<ApplicationUser> _userManager;
@{

    ViewData["Title"] = "Employees";
    GlobalUI.PageTitle = ViewBag.Title;

}
@section Styles{
    <style>
        .img-responsive
        {
            max-width: 100%;
            height: auto;
        }

        .img-circle
        {
            border-radius: 100%;
        }

        /* Square, circular employee photo that never distorts: the box keeps a 1:1
           ratio at any column width and object-fit crops instead of stretching. */
        .employee-avatar
        {
            display: block;
            width: 100%;
            max-width: 140px;
            aspect-ratio: 1 / 1;
            height: auto;
            margin: 0 auto 0.5rem;
            object-fit: cover;
            object-position: center top; /* keep faces in frame on portrait photos */
            border-radius: 50%;
            border: 1px solid #d6d6d6;
            background-color: #f8f9fa;
        }
    </style>
}

<div class="row">
    <div class="col-md-12 text-end pb-2 d-flex justify-content-end gap-2">
        <partial name="_Create" />
        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#exportModal">
            <i class="fa fa-download"></i> Export
        </button>
    </div>
</div>

<div class="modal fade" id="exportModal" tabindex="-1" aria-labelledby="exportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exportModalLabel">Select Fields to Export</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">Select the fields you want to include in the export:</p>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input export-field" type="checkbox" value="EmployeeName" id="fieldEmployeeName" checked>
                            <label class="form-check-label" for="fieldEmployeeName">Employee Name</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input export-field" type="checkbox" value="EmployeeNameBangla" id="fieldEmployeeNameBangla">
                            <label class="form-check-label" for="fieldEmployeeNameBangla">Name (Bangla)</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input export-field" type="checkbox" value="FatherName" id="fieldFatherName">
                            <label class="form-check-label" for="fieldFatherName">Father Name</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input export-field" type="checkbox" value="MotherName" id="fieldMotherName">
                            <label class="form-check-label" for="fieldMotherName">Mother Name</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input export-field" type="checkbox" value="Phone" id="fieldPhone" checked>
                            <label class="form-check-label" for="fieldPhone">Phone</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input export-field" type="checkbox" value="Email" id="fieldEmail" checked>
                            <label class="form-check-label" for="fieldEmail">Email</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input export-field" type="checkbox" value="Designation" id="fieldDesignation" checked>
                            <label class="form-check-label" for="fieldDesignation">Designation</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input export-field" type="checkbox" value="EmpType" id="fieldEmpType">
                            <label class="form-check-label" for="fieldEmpType">Employee Type</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input export-field" type="checkbox" value="Gender" id="fieldGender">
                            <label class="form-check-label" for="fieldGender">Gender</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input export-field" type="checkbox" value="BloodGroup" id="fieldBloodGroup">
                            <label class="form-check-label" for="fieldBloodGroup">Blood Group</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input export-field" type="checkbox" value="Religion" id="fieldReligion">
                            <label class="form-check-label" for="fieldReligion">Religion</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input export-field" type="checkbox" value="DOB" id="fieldDOB">
                            <label class="form-check-label" for="fieldDOB">Date of Birth</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input export-field" type="checkbox" value="NIDNo" id="fieldNIDNo">
                            <label class="form-check-label" for="fieldNIDNo">NID No</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input export-field" type="checkbox" value="JoiningDate" id="fieldJoiningDate" checked>
                            <label class="form-check-label" for="fieldJoiningDate">Joining Date</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input export-field" type="checkbox" value="PresentAddress" id="fieldPresentAddress">
                            <label class="form-check-label" for="fieldPresentAddress">Present Address</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input export-field" type="checkbox" value="PermanentAddress" id="fieldPermanentAddress">
                            <label class="form-check-label" for="fieldPermanentAddress">Permanent Address</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input export-field" type="checkbox" value="Nominee" id="fieldNominee">
                            <label class="form-check-label" for="fieldNominee">Nominee</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input export-field" type="checkbox" value="NomineePhone" id="fieldNomineePhone">
                            <label class="form-check-label" for="fieldNomineePhone">Nominee Phone</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input export-field" type="checkbox" value="Status" id="fieldStatus" checked>
                            <label class="form-check-label" for="fieldStatus">Status</label>
                        </div>
                    </div>
                </div>
                <hr />
                <div class="mb-3">
                    <label class="form-label fw-bold">Filter by Status</label>
                    <select id="exportStatus" class="form-select">
                        <option value="all" selected>All Employees</option>
                        <option value="active">Active Only</option>
                        <option value="inactive">Inactive Only</option>
                    </select>
                </div>
                <div class="mt-3">
                    <a href="#" id="previewExportBtn" class="btn btn-primary">
                        <i class="fa fa-eye"></i> Preview & Export
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row d-flex justify-content-center">
    @foreach (var desigNation in Model.OrderBy(d => d.Designation.SortingOrder).GroupBy(c => c.Designation.DesignationName))
    {
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-light">
                <h6 class="mb-0 text-muted">@desigNation.Key</h6>
            </div>
            <div class="row">
                @foreach (var item in desigNation)
                {
                    if (item.Status)
                    {
                        <partial name="_profileCard" model="item" />
                    }
                }
            
            </div>
        </div>
    }
    
    <div class="row d-flex justify-content-center">
        <div class="card">
            <div class="card-header bg-dark">
                <h6 class="mb-0 text-muted">Inactive Employees</h6>
            </div>
            <div class="row">
                @foreach (var item in Model)
                {
                    if (!item.Status)
                    {
                        <partial name="_profileCard" model="item" />
                    }
                }

            </div>
        </div>
    </div>
</div>

@section Scripts{
    @*<script src="~/js/AlertifyNotify/successNotify.js"></script>*@
    <script>

    $(document).ready(function () {

        $(function () {
            let saved = '@TempData["saved"]';
            let deleted = '@TempData["deleted"]';
            let edited = '@TempData["edited"]';

            if (saved != "") {
                alertify.success("Saved Successfully");
            }
            if (deleted != "") {
                alertify.error("Deleted Successfully");
            }
            if (edited != "") {
                alertify.message('Updated Successfully');
            }
        });

        $('#previewExportBtn').click(function (e) {
            e.preventDefault();
            var selectedFields = [];
            $('.export-field:checked').each(function () {
                selectedFields.push($(this).val());
            });

            if (selectedFields.length === 0) {
                alertify.warning("Please select at least one field");
                return;
            }

            var fieldsParam = selectedFields.join(',');
            var statusParam = $('#exportStatus').val();
            window.location.href = '@Url.Action("Export", "Employees")?fields=' + encodeURIComponent(fieldsParam) + '&status=' + statusParam;
        });
    });
    </script>
}