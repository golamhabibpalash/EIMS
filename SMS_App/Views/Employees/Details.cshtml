@using Microsoft.AspNetCore.Identity;

@inject UserManager<ApplicationUser> _userManager;

@model SMS_App.ViewModels.Employees.EmployeeDetailsVM

@{
    if (ViewBag.InstituteName != null)
    {
        GlobalUI.InstituteName = ViewBag.InstituteName;
    }

    ViewData["Title"] = "Details";
    GlobalUI.PageTitle = ViewBag.Title + " about " + Model.EmployeeName;
    string image = Model.Image;
    if (string.IsNullOrEmpty(Model.Image))
    {
        if (Model.Gender.Name.ToLower() == "male")
        {
            image = "maleEmployee.png";
        }
        else if (Model.Gender.Name.ToLower() == "female")
        {
            image = "femaleEmployee.png";
        }
        else
        {

            image = "otherEmployee.jpg";
        }
    }
}


@{
    string presentUpazila = Model.PresentUpazila != null ? Model.PresentUpazila.Name : "N/A";
    string presentDistrict = Model.PresentDistrict != null ? Model.PresentDistrict.Name : "N/A";
    string presentDivision = Model.PresentDivision != null ? Model.PresentDivision.Name : "N/A";
    string permanentUpazila = Model.PermanentUpazila != null ? Model.PermanentUpazila.Name : "N/A";
    string permanentDistrict = Model.PermanentDistrict != null ? Model.PermanentDistrict.Name : "N/A";
    string permanentDivision = Model.PermanentDivision != null ? Model.PermanentDivision.Name : "N/A";
}

<div class="row">
    <div class="col-md-3">
        <div class="row">
            <img class="rounded-circle img-thumbnail w-50 d-block mx-auto" src="~/Images/Employee/photo/@image"
                 alt="@Model.EmployeeName"
                 onerror="this.onerror=null;this.src='/Images/Employee/photo/maleEmployee.png';" />
        </div>
        <div class="text-center my-2">
            <h5 class="mb-0 text-capitalize">@Model.EmployeeName</h5>
            <small class="text-muted">@(Model.Designation?.DesignationName)</small><br />
            @if (Model.Status)
            {
                <span class="badge bg-success">Active</span>
            }
            else
            {
                <span class="badge bg-secondary">Inactive</span>
            }
        </div>
        <div class="nav flex-column nav-pills" id="emp-tab" role="tablist" aria-orientation="vertical">
            <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#pane-personal" type="button" role="tab">Personal Information</button>
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#pane-official" type="button" role="tab">Official Information</button>
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#pane-address" type="button" role="tab">Address</button>
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#pane-other" type="button" role="tab">Other Information</button>
        </div>
    </div>
    <div class="col-md-9">
        <div class="tab-content" id="emp-tabContent">
            <div class="tab-pane fade show active bg-Teal shadow rounded p-2" id="pane-personal" role="tabpanel">
                <table class="table table-responsive-sm text-light mb-0">
                    <tr><td>Employee Name</td><td>:</td><td>@Model.EmployeeName</td></tr>
                    <tr><td>Name (Bangla)</td><td>:</td><td>@Model.EmployeeNameBangla</td></tr>
                    <tr><td>Date of Birth</td><td>:</td><td>@Model.DOB.ToString("dd MMM yyyy")</td></tr>
                    <tr><td>Gender</td><td>:</td><td>@(Model.Gender?.Name ?? "N/A")</td></tr>
                    <tr><td>Blood Group</td><td>:</td><td>@(Model.BloodGroup?.Name ?? "N/A")</td></tr>
                    <tr><td>Religion</td><td>:</td><td>@(Model.Religion?.Name ?? "N/A")</td></tr>
                    <tr><td>Nationality</td><td>:</td><td>@(Model.Nationality?.Name ?? "N/A")</td></tr>
                    <tr><td>National ID</td><td>:</td><td>@Model.NIDNo</td></tr>
                    <tr><td>Phone number</td><td>:</td><td>@Model.Phone</td></tr>
                    <tr><td>Email</td><td>:</td><td>@Model.Email</td></tr>
                </table>
            </div>
            <div class="tab-pane fade bg-Teal shadow rounded p-2" id="pane-official" role="tabpanel">
                <table class="table table-responsive-sm text-light mb-0">
                    <tr><td>Employee ID</td><td>:</td><td>@Model.Id.ToString().PadLeft(5, '0')</td></tr>
                    <tr><td>Designation</td><td>:</td><td>@(Model.Designation?.DesignationName ?? "N/A")</td></tr>
                    <tr><td>Employee Type</td><td>:</td><td>@ViewBag.EmpTypeName</td></tr>
                    <tr><td>Joining Date</td><td>:</td><td>@Model.JoiningDate.ToString("dd MMM yyyy")</td></tr>
                    <tr><td>Status</td><td>:</td><td>@(Model.Status ? "Active" : "Inactive")</td></tr>
                </table>
            </div>
            <div class="tab-pane fade bg-Teal shadow rounded p-2" id="pane-address" role="tabpanel">
                <table class="table table-responsive-sm text-light mb-0">
                    <tr><td>Present Address</td><td>:</td><td>@Model.PresentAddress, Thana/Upazila: @presentUpazila, Dist: @presentDistrict, Div: @presentDivision</td></tr>
                    <tr><td>Permanent Address</td><td>:</td><td>@Model.PermanentAddress, Thana/Upazila: @permanentUpazila, Dist: @permanentDistrict, Div: @permanentDivision</td></tr>
                </table>
            </div>
            <div class="tab-pane fade bg-Teal shadow rounded p-2" id="pane-other" role="tabpanel">
                <table class="table table-responsive-sm text-light mb-0">
                    <tr><td>Nominee Name</td><td>:</td><td>@(string.IsNullOrEmpty(Model.Nominee) ? "N/A" : Model.Nominee)</td></tr>
                    <tr><td>Nominee Phone</td><td>:</td><td>@(string.IsNullOrEmpty(Model.NomineePhone) ? "N/A" : Model.NomineePhone)</td></tr>
                    <tr>
                        <td>NID Card</td>
                        <td>:</td>
                        <td>
                            @if (!string.IsNullOrEmpty(Model.NIDCard))
                            {
                                <a class="link-light" href="/Images/Employee/NID/@Model.NIDCard" target="_blank" rel="noopener">View NID card</a>
                            }
                            else
                            {
                                <text>N/A</text>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td>Documents</td>
                        <td>:</td>
                        <td>
                            @if (Model.Documents != null && Model.Documents.Any())
                            {
                                <ul class="mb-0 ps-3">
                                    @foreach (var doc in Model.Documents)
                                    {
                                        <li>
                                            @if (!string.IsNullOrEmpty(doc.Image))
                                            {
                                                <a class="link-light" href="@doc.Image" target="_blank" rel="noopener">@(string.IsNullOrEmpty(doc.DocumentsName) ? "Document" : doc.DocumentsName)</a>
                                            }
                                            else
                                            {
                                                @(string.IsNullOrEmpty(doc.DocumentsName) ? "Document" : doc.DocumentsName)
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <text>No documents attached.</text>
                            }
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-md-12 p-2 text-center">
        <partial name="_Edit_Back" model="@Model.Id" />
    </div>
</div>
