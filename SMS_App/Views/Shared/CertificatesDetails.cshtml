@model SMS.Entities.StudentCertificate
@{
    var controllerName = (string)ViewBag.ControllerName;
    var title = (string)ViewBag.Title;
    ViewData["Title"] = title + " Details";
    GlobalUI.PageTitle = ViewData["Title"].ToString();
    var canManage = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");
    var isTransfer = Model.Type == SMS.Entities.Enums.CertificateType.TransferCertificate;
}

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fa fa-certificate mr-2"></i> @title</h5>
        <div class="btn-group btn-group-sm">
            <a asp-controller="@controllerName" asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-danger"><i class="fa fa-file-pdf"></i> View PDF</a>
            <a asp-controller="@controllerName" asp-action="Print" asp-route-id="@Model.Id" asp-route-download="true" class="btn btn-outline-danger"><i class="fa fa-download"></i> Download</a>
            @if (canManage)
            {
                <a asp-controller="@controllerName" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="fa fa-edit"></i> Edit</a>
            }
            <a asp-controller="@controllerName" asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Student Name</dt><dd class="col-sm-9">@Model.StudentNameSnapshot</dd>
            <dt class="col-sm-3">Student ID</dt><dd class="col-sm-9">@Model.UniqueIdSnapshot</dd>
            <dt class="col-sm-3">Class</dt><dd class="col-sm-9">@Model.ClassNameSnapshot</dd>
            <dt class="col-sm-3">Section</dt><dd class="col-sm-9">@(Model.SectionNameSnapshot ?? "-")</dd>
            <dt class="col-sm-3">Roll</dt><dd class="col-sm-9">@Model.ClassRollSnapshot</dd>
            <dt class="col-sm-3">Session</dt><dd class="col-sm-9">@Model.SessionNameSnapshot</dd>
            <dt class="col-sm-3">Date of Birth</dt><dd class="col-sm-9">@Model.DobSnapshot.ToString("dd MMM yyyy")</dd>
            <dt class="col-sm-3">Issue Date</dt><dd class="col-sm-9">@Model.IssueDate.ToString("dd MMM yyyy")</dd>
            <dt class="col-sm-3">Delivery Date</dt><dd class="col-sm-9">@(Model.DeliveryDate?.ToString("dd MMM yyyy") ?? "-")</dd>
            @if (isTransfer)
            {
                <dt class="col-sm-3">Date of Leaving</dt><dd class="col-sm-9">@(Model.LeavingDate?.ToString("dd MMM yyyy") ?? "-")</dd>
                <dt class="col-sm-3">Reason for Leaving</dt><dd class="col-sm-9">@(Model.Reason ?? "-")</dd>
                <dt class="col-sm-3">Last Exam</dt><dd class="col-sm-9">@(Model.ExamName ?? "-") | Marks: @(Model.TotalMarks ?? "-") | GPA: @(Model.Gpa ?? "-") | Grade: @(Model.Grade ?? "-") | Rank: @(Model.MeritRank ?? "-")</dd>
            }
            <dt class="col-sm-3">Signatory</dt><dd class="col-sm-9">@(Model.SignatoryName ?? "-") (@Model.SignatoryDesignation)</dd>
            <dt class="col-sm-3">Created</dt><dd class="col-sm-9">@Model.CreatedAt.ToString("dd MMM yyyy") by @Model.CreatedBy</dd>
        </dl>
    </div>
</div>
