    <link href="~/lib/Theme/smart/assets/css/theme/light/style.css" rel="stylesheet" type="text/css" />
    <link href="~/lib/Theme/smart/assets/css/plugins.min.css" rel="stylesheet" type="text/css" />
    <link href="~/lib/Theme/smart/assets/css/responsive.css" rel="stylesheet" type="text/css" />
    <link href="~/lib/Theme/smart/assets/css/theme/light/theme-color.css" rel="stylesheet" type="text/css" />

    <!-- Select2 Bootstrap 5 Theme CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />

    <!-- dropzone -->
    <link href="~/lib/Theme/smart/assets/plugins/dropzone/dropzone.css" rel="stylesheet" media="screen">

    <!-- Date Time item CSS -->
    <link rel="stylesheet" href="~/lib/Theme/smart/assets/plugins/flatpicker/css/flatpickr.min.css" />

    <!-- favicon -->
    <link rel="icon" type="image/x-icon" href="~/Images/Institute/favicon.ico">
    <link href="~/lib/Theme/smart/assets/css/theme/light/login.css" rel="stylesheet" />

    <!-- Select2 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />

    <!--Custom Css-->
    <link href="~/css/custom.css" rel="stylesheet" />
    <link href="~/lib/Alertify/css/alertify.min.css" rel="stylesheet" />
    <style>

        /* Fix for select2 search input */
        .select2-container--bootstrap-5 .select2-search--dropdown .select2-search__field {
            background-color: #fff !important;
            color: #333 !important;
            border: 1px solid #ced4da !important;
            padding: 0.375rem 0.75rem !important;
            border-radius: 0.25rem !important;
            outline: none !important;
        }

            .select2-container--bootstrap-5 .select2-search--dropdown .select2-search__field:focus {
                border-color: #86b7fe !important;
                box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
            }

        /* Fix for modal focus issues */
        .modal .select2-container--bootstrap-5 .select2-selection--single,
        .modal .select2-container--bootstrap-5 .select2-selection--multiple {
            pointer-events: auto !important;
        }

        /* Fix for Select2 dropdown behind modal */
        .select2-container--open {
            z-index: 99999 !important;
        }

        /* Ensure dropdown is above modal (works with dropdownParent: body) */
        .select2-dropdown {
            z-index: 99999 !important;
        }

        /* Fix for search input in modal */
        .modal .select2-container--bootstrap-5 .select2-selection--single,
        .modal .select2-container--bootstrap-5 .select2-selection--multiple {
            position: relative;
            z-index: 1;
        }

        /* Ensure dropdown container is above everything */
        .select2-container {
            z-index: 10000 !important;
        }

        /* Fix for Select2 within modals - ensure proper dropdown rendering */
        .modal .select2-results__options {
            max-height: 300px !important;
            overflow-y: auto !important;
        }



        /* Multiple select styling */
        .select2-container--bootstrap-5 .select2-selection--multiple {
            min-height: 38px !important;
        }

        /* Override any conflicting theme styles */
        .select2-container--bootstrap-5 .select2-selection--multiple .select2-selection__choice {
            background-color: #e7f1ff !important;
            border-color: #86b7fe !important;
        }

        /* Fix for dropdown list appearing as inline instead of dropdown */
        .select2-container--bootstrap-5.select2-container--open .select2-dropdown {
            border-top: 1px solid #dee2e6 !important;
        }

        /* Remove any overflow hidden that might be hiding the dropdown */
        .select2-container {
            overflow: visible !important;
        }

        /* Fix select2 dropdown hidden behind modal by removing overflow clipping */
        .modal:has(.select2-container--open),
        .modal:has(.select2-container--open) .modal-dialog,
        .modal:has(.select2-container--open) .modal-content,
        .modal:has(.select2-container--open) .card {
            overflow: visible !important;
        }

        /* Force select2 open container and dropdown above modal (1055) and backdrop (1050) */
        .select2-container--bootstrap-5.select2-container--open {
            z-index: 99999 !important;
        }

        .select2-container--bootstrap-5 .select2-dropdown {
            z-index: 99999 !important;
        }


    </style>

    <!-- Tesseract.js for OCR -->
    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>

    <!-- start js include path -->
    <!-- jQuery MUST be first -->
    <script src="~/lib/Theme/smart/assets/plugins/jquery/jquery.min.js"></script>

    <!-- DataTables (after jQuery) -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <!-- Ensure jQuery is loaded before Select2 -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script src="~/lib/Theme/smart/assets/plugins/popper/popper.js"></script>
    <script src="~/lib/Theme/smart/assets/plugins/jquery-blockui/jquery.blockui.min.js"></script>
    <script src="~/lib/Theme/smart/assets/plugins/jquery-slimscroll/jquery.slimscroll.js"></script>

    <!-- bootstrap -->
    <script src="~/lib/Theme/smart/assets/plugins/bootstrap/js/bootstrap.min.js"></script>

    <script src="~/lib/Theme/smart/assets/plugins/sparkline/jquery.sparkline.min.js"></script>

    <!-- Common js-->
    <script src="~/lib/Theme/smart/assets/js/app.js"></script>
    <script src="~/lib/Theme/smart/assets/js/layout.js"></script>
    <script src="~/lib/Theme/smart/assets/js/theme-color.js"></script>

    <!-- material -->
    <script src="~/lib/Theme/smart/assets/plugins/material/material.min.js"></script>

    <!-- dropzone -->
    <script src="~/lib/Theme/smart/assets/plugins/dropzone/dropzone.js"></script>
    <script src="~/lib/Theme/smart/assets/plugins/dropzone/dropzone-call.js"></script>

    <!-- Feather icon -->
    <script src="~/lib/Theme/smart/assets/plugins/feather/feather.min.js"></script>
    <script src="~/lib/Alertify/alertify.min.js"></script>
    <script>feather.replace();</script>

    <script>
        function matchText(term, text) {
            return text.toLowerCase().indexOf(term.toLowerCase()) > -1;
        }

        function matchStart(params, data) {
            if ($.trim(params.term) === '') return data;
            if (typeof data.text === 'undefined') return null;
            if (matchText(params.term, data.text)) {
                return data;
            }
            return null;
        }

        function initSelect2($el) {
            var placeholder = $el.data('placeholder') || 'Select an option';
            $el.select2({
                theme: 'bootstrap-5',
                width: $el.data('width') || '100%',
                allowClear: true,
                matcher: matchStart,
                placeholder: placeholder,
                dropdownParent: $(document.body)
            });
        }

        function fixSelect2ZIndex() {
            var $dropdown = $('.select2-container--bootstrap-5.select2-container--open .select2-dropdown');
            if ($dropdown.length) {
                $dropdown.css('z-index', '99999');
            }
            var $container = $('.select2-container--bootstrap-5.select2-container--open');
            if ($container.length) {
                $container.css('z-index', '99999');
            }
        }

        $(document).ready(function () {
            $('.select2').each(function () {
                initSelect2($(this));
            });

            $(document).on('shown.bs.modal', '.modal', function () {
                $(this).find('.select2').each(function () {
                    var $this = $(this);
                    if ($this.data('select2')) {
                        $this.select2('destroy');
                    }
                    initSelect2($this);
                });
            });

            $(document).on('hidden.bs.modal', '.modal', function () {
                $(this).find('.select2').each(function () {
                    if ($(this).data('select2')) {
                        $(this).select2('destroy');
                    }
                });
            });

            $(document).on('select2:open', function () {
                fixSelect2ZIndex();
            });
        });
    </script>

</head>
