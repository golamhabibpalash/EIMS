        (function () {
            window.EIMS_SIDEBAR_KEY = "eims.sidebar.collapsed.@sidebarUserKey";
            try {
                // 992px is the theme's "md" breakpoint; below it the sidebar uses the
                // mobile slide-out instead, which has its own open/closed handling.
                if (localStorage.getItem(window.EIMS_SIDEBAR_KEY) === "1" && window.innerWidth >= 992) {
