                                            </div>
                                        </div>
                                        <div class="settings-item">
                                            <div class="settings-name">Show Email Notifications</div>
                                            <div class="settings-value">
                                                <input type="checkbox" class="js-switch" checked />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- end chat sidebar -->
            </div>
            <!-- end page container -->
            <!-- start footer -->
            <div class="page-footer text-bs-light">
                <footer class="py-3 mt-auto">
                    <div class="d-flex flex-wrap justify-content-between align-items-center page-footer-inner">

                        <!-- Part 1: Version -->
                        <div class="footer-version text-start col-12 col-md-4 mb-2 mb-md-0">
                            <strong>Version:</strong> @BuildInfo.ShortDisplay
                        </div>

                        <!-- Part 2: Institute Name -->
                        <div class="footer-institute text-center col-12 col-md-4 mb-2 mb-md-0">
                            <strong>Institute:</strong> @instituteName
                        </div>

                        <!-- Part 3: Developer Info -->
                        <div class="footer-developer text-end col-12 col-md-4">
                            @DateTime.Today.Year &copy; EIMS! Developed By
                            <a href="mailto:golamhabibpalash@gmail.com" class="text-decoration-none">G H Palash</a>
                        </div>

                    </div>

                    <!-- Optional Scroll to Top Button -->
                    <div class="scroll-to-top position-absolute end-0 me-3 mb-3" style="cursor:pointer;">
                        <i class="icon-arrow-up"></i>
                    </div>
                </footer>
            </div>


        </div>

        <!-- Modal -->
        <div class="modal fade" id="versionModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
             aria-labelledby="staticBackdropLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="staticBackdropLabel">Version Info</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <dl class="row mb-0">
                            <dt class="col-5">Version</dt>
                            <dd class="col-7">@BuildInfo.Version</dd>

                            <dt class="col-5">Build</dt>
                            <dd class="col-7">@(BuildInfo.IsOfficialBuild ? "Deployment build" : "Local build")</dd>

                            <dt class="col-5">Commit</dt>
                            <dd class="col-7"><code>@BuildInfo.Commit</code></dd>

                            @if (!string.IsNullOrWhiteSpace(BuildInfo.BuiltUtc))
                            {
                                <dt class="col-5">Built (UTC)</dt>
                                <dd class="col-7">@BuildInfo.BuiltUtc</dd>
                            }

                            <dt class="col-5">Institute</dt>
                            <dd class="col-7">@instituteName</dd>
                        </dl>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary">Understood</button>
                    </div>
                </div>
            </div>
        </div>



        <script>
            // Remember the sidebar state across pages. The theme's own handler in layout.js
            // does the toggling; this only records the result once that handler has run.
            (function () {
                var key = window.EIMS_SIDEBAR_KEY;
                if (!key) { return; }

                $(function () {
                    // The pre-paint script could only reach <body>; .sidemenu exists by now
                    // and the theme expects the same class on both.
                    if (document.body.classList.contains("sidemenu-closed")) {
                        $(".sidemenu").addClass("sidemenu-closed");
                    }

                    $("body").on("click", ".sidebar-toggler", function () {
                        // Deferred so we read the class after the theme handler flips it,
                        // whichever order the two handlers happen to be bound in.
                        setTimeout(function () {
                            try {
                                localStorage.setItem(key, document.body.classList.contains("sidemenu-closed") ? "1" : "0");
                            } catch (e) { /* storage blocked: state just is not remembered */ }
                        }, 0);
                    });
                });
            })();
        </script>

        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>