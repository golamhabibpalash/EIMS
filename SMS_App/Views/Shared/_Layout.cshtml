@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Http
@using SMS_App.ViewModels.Layout 
@using System.IO

@inject SignInManager<ApplicationUser> _signInManager
@inject UserManager<ApplicationUser> _userManager
@inject IInstituteManager _instituteManager
@inject IEmployeeManager _employeeManager
@inject IStudentManager _studentManager
@inject IHttpContextAccessor httpContextAccessor
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _webHostEnvironment 


@{
    var headerVM = new LayoutHeaderVM();

    var info = await _instituteManager.GetAllAsync();
    var user = await _userManager.GetUserAsync(User);

    if (info.Any())
    {
        var firstInstitute = info.First();
        GlobalUI.InstituteName = firstInstitute.Name;
        GlobalUI.Logo = firstInstitute.Logo;
        GlobalUI.Language = "En";
    }

    string instituteName = GlobalUI.InstituteName ?? "Institute Name";
    string instituteLogo = GlobalUI.Logo ?? "instituteLogo.png";
    var userName = _userManager.GetUserName(User);
    // Scopes the remembered sidebar state to this user, so two people sharing a browser keep their own preference.
    var sidebarUserKey = user?.Id ?? "anon";
    headerVM.InstituteName = instituteName;

    string userImage = "/Images/noProfileImage.png";

    if (_signInManager.IsSignedIn(User) && user != null)
    {
        if (user.UserType == 's')
        {
            var stu = await _studentManager.GetByIdAsync(user.ReferenceId);
            if (!string.IsNullOrEmpty(stu?.Photo))
                userImage = $"/Images/Student/Photo/{stu.Photo}";
        }


        else if (user.UserType == 'e')
        {
            // var emp = await _employeeManager.GetByIdAsync(user.ReferenceId);
            // // Fix: Use Path.Combine from System.IO and ensure _webHostEnvironment is injected
            // var imagePath = System.IO.Path.Combine(_webHostEnvironment.WebRootPath, "Images", "Employee", "Photo", emp?.Image);

            // userImage = System.IO.File.Exists(imagePath) ? $"/Images/Employee/Photo/{emp?.Image}" : userImage;
            
        }
    }
    else
    {
        <a asp-area="Identity" asp-page="/Account/Login">Log in</a>
    }

}


