@model SMS_App.ViewModels.Tickets.TicketDetailsVM
@{
    ViewData["Title"] = "Ticket";
    GlobalUI.PageTitle = $"Ticket #{Model.Ticket.Id}";
}

<partial name="_Alerts" />

<div class="row">
    <div class="col-md-8">
        <fieldset class="border p-3 shadow mb-3">
            <legend class="float-none w-auto text-primary px-2" style="font-size:1.1rem;">
                #@Model.Ticket.Id &middot; @Model.Ticket.Title
            </legend>

            <div class="d-flex flex-wrap gap-3 mb-3 small text-muted">
                <span><partial name="_StatusBadge" model="Model.Ticket.Status" /></span>
                <span><strong>Type:</strong> @Model.Ticket.TicketType</span>
                <span><strong>Raised:</strong> @Model.Ticket.RaiseDate.ToString("dd MMM yyyy hh:mm tt")</span>
                <span><strong>By:</strong> @Model.RaisedByName</span>
                @if (Model.Ticket.ClosedAt.HasValue)
                {
                    <span><strong>Closed:</strong> @Model.Ticket.ClosedAt.Value.ToString("dd MMM yyyy hh:mm tt")</span>
                }
            </div>

            <p style="white-space: pre-wrap;">@Model.Ticket.Description</p>

            <div class="text-end">
                <a asp-action="Index" class="btn btn-sm btn-secondary">Back to list</a>
                <a asp-action="Edit" asp-route-id="@Model.Ticket.Id" class="btn btn-sm btn-warning">Edit</a>
            </div>
        </fieldset>

        <fieldset class="border p-3 shadow">
            <legend class="float-none w-auto text-primary px-2" style="font-size:1.1rem;">Discussion</legend>

            @if (!Model.Comments.Any())
            {
                <p class="text-muted">No discussion yet. Start it below.</p>
            }
            else
            {
                <ul class="list-unstyled mb-3">
                    @foreach (var comment in Model.Comments)
                    {
                        <li class="mb-3 pb-2 border-bottom">
                            @if (comment.IsSystemNote)
                            {
                                <div class="small text-muted fst-italic">
                                    <i class="fa fa-history"></i>
                                    @comment.Message
                                    &mdash; @comment.AuthorName, @comment.CreatedAt.ToString("dd MMM yyyy hh:mm tt")
                                </div>
                            }
                            else
                            {
                                <div class="d-flex justify-content-between">
                                    <strong>@comment.AuthorName</strong>
                                    <small class="text-muted">@comment.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</small>
                                </div>
                                <div style="white-space: pre-wrap;">@comment.Message</div>
                            }
                        </li>
                    }
                </ul>
            }

            <form asp-action="AddComment" asp-route-id="@Model.Ticket.Id" method="post">
                <div class="mb-2">
                    <label asp-for="NewComment" class="form-label"></label>
                    <textarea name="newComment" class="form-control" rows="3"
                              placeholder="Reply, add detail, or ask a question."></textarea>
                </div>
                <div class="text-end">
                    <button type="submit" class="btn btn-sm btn-primary">Post Comment</button>
                </div>
            </form>
        </fieldset>
    </div>

    <div class="col-md-4">
        @if (Model.CanManage)
        {
            <fieldset class="border p-3 shadow mb-3">
                <legend class="float-none w-auto text-primary px-2" style="font-size:1.1rem;">Developer Action</legend>
                <form asp-action="ChangeStatus" asp-route-id="@Model.Ticket.Id" method="post">
                    <div class="mb-2">
                        <label asp-for="NewStatus" class="form-label"></label>
                        <select name="newStatus" asp-items="Model.StatusList" class="form-control"></select>
                    </div>
                    <div class="mb-2">
                        <label asp-for="StatusNote" class="form-label"></label>
                        <textarea name="statusNote" class="form-control" rows="2"
                                  placeholder="Optional - added to the discussion with the change."></textarea>
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-sm btn-success">Update Status</button>
                    </div>
                </form>
            </fieldset>
        }

        <fieldset class="border p-3 shadow mb-3">
            <legend class="float-none w-auto text-primary px-2" style="font-size:1.1rem;">Attachments</legend>
            @if (Model.Attachments.Any())
            {
                var imageAttachments = Model.Attachments.Where(f => (f.ContentType ?? "").StartsWith("image/")).ToList();
                @if (imageAttachments.Any())
                {
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @foreach (var file in imageAttachments)
                        {
                            <a asp-action="ViewAttachment" asp-route-id="@file.Id" target="_blank" title="@file.OriginalFileName">
                                <img src="@Url.Action("ViewAttachment", new { id = file.Id })"
                                     alt="@file.OriginalFileName" class="border rounded"
                                     style="width:70px;height:70px;object-fit:cover;" />
                            </a>
                        }
                    </div>
                }
                <ul class="list-group list-group-flush">
                    @foreach (var file in Model.Attachments)
                    {
                        <li class="list-group-item px-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-truncate" style="max-width:60%;" title="@file.OriginalFileName">@file.OriginalFileName</span>
                                <span class="small text-nowrap">
                                    <a asp-action="ViewAttachment" asp-route-id="@file.Id" target="_blank">View</a>
                                    &middot;
                                    <a asp-action="DownloadAttachment" asp-route-id="@file.Id">Download</a>
                                </span>
                            </div>
                            <div class="small text-muted">@(Math.Round(file.FileSize / 1024.0, 1)) KB</div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted mb-0">No files attached.</p>
            }
        </fieldset>
    </div>
</div>
