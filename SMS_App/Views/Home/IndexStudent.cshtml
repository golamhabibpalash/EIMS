@model SMS_App.ViewModels.Students.StudentDashboardVM
@{
    ViewData["Title"] = "My Dashboard";
    GlobalUI.PageTitle = "My Dashboard";
    var photo = !string.IsNullOrEmpty(Model.Student?.Photo) ? "/Images/Student/" + Model.Student.Photo : "/Images/noProfileImage.png";
    var due = Model.Payment?.TotalDue ?? 0;
}
@section Styles{
    <style>
        .stat-card { border: none; border-radius: 12px; overflow: hidden; transition: transform .2s; }
        .stat-card:hover { transform: translateY(-3px); }
        .stat-label { font-size: .85rem; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; margin-bottom: .25rem; }
        .stat-number { font-size: 2rem; font-weight: 700; margin-bottom: .5rem; }
        .stat-icon-wrap { width: 52px; height: 52px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; }
        .detail-row { display: flex; gap: 1.5rem; margin-top: .75rem; }
        .detail-item label { display: block; font-size: .75rem; color: #6c757d; margin-bottom: .15rem; }
        .stat-footer-link { display: flex; justify-content: space-between; align-items: center; padding: .6rem 1.25rem; font-size: .85rem; font-weight: 600; background: rgba(0,0,0,.04); }
    </style>
}

<div class="row mb-3">
    <div class="col-md-12">
        <div class="card shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <img src="@photo" alt="Photo" class="rounded-circle" style="width:72px;height:72px;object-fit:cover;" onerror="this.onerror=null;this.src='/Images/noProfileImage.png';" />
                <div class="flex-grow-1">
                    <h4 class="mb-1">@Model.Student?.Name</h4>
                    <div class="text-muted">
                        Class: <strong>@Model.Student?.AcademicClass?.Name</strong>
                        &nbsp;|&nbsp; Roll: <strong>@Model.Student?.ClassRoll</strong>
                        &nbsp;|&nbsp; Session: <strong>@Model.SessionName</strong>
                    </div>
                </div>
                <a asp-controller="Students" asp-action="Profile" asp-route-id="@Model.Student?.UniqueId" class="btn btn-navy-blue btn-sm"><i class="fa fa-id-card"></i> Full Profile</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-4 col-lg-6 col-md-6 mb-4">
        <div class="card stat-card h-100">
            <div class="card-body" style="background: linear-gradient(135deg, #e8f5e9, #c8e6c9);">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="stat-label text-success">My Attendance</p>
                        <h2 class="stat-number" style="color: #007c03;">@Model.Attendance.OverallAttendance.ToString("N1")%</h2>
                    </div>
                    <div class="stat-icon-wrap" style="background: linear-gradient(135deg, #007c03, #015902); color: white;">
                        <i class="fa fa-clipboard-check"></i>
                    </div>
                </div>
                <div class="detail-row">
                    <div class="detail-item">
                        <label>Present</label>
                        <strong class="text-success">@Model.Attendance.DaysPresent days</strong>
                    </div>
                    <div class="detail-item">
                        <label>Absent</label>
                        <strong class="text-danger">@Model.Attendance.DaysAbsent days</strong>
                    </div>
                    <div class="detail-item">
                        <label>Today</label>
                        <strong>@(string.IsNullOrEmpty(Model.Attendance.TodaysAttendance) ? "-" : Model.Attendance.TodaysAttendance)</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-lg-6 col-md-6 mb-4">
        <div class="card stat-card h-100">
            <div class="card-body" style="background: linear-gradient(135deg, #e7f1ff, #bbd4f8);">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="stat-label text-primary">My Result</p>
                        <h2 class="stat-number text-primary">@Model.Result.CurrentGrade</h2>
                    </div>
                    <div class="stat-icon-wrap" style="background: linear-gradient(135deg, #0d6efd, #0a58ca); color: white;">
                        <i class="fa fa-award"></i>
                    </div>
                </div>
                <div class="detail-row">
                    <div class="detail-item">
                        <label>Exam</label>
                        <strong>@Model.Result.CurrentExamName</strong>
                    </div>
                    <div class="detail-item">
                        <label>CGPA</label>
                        <strong>@Model.Result.CurrentCGPA.ToString("N2")</strong>
                    </div>
                    <div class="detail-item">
                        <label>Rank</label>
                        <strong>@(Model.Result.CurrentClassRank > 0 ? Model.Result.CurrentClassRank.ToString() : "-")</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-lg-6 col-md-6 mb-4">
        <div class="card stat-card h-100">
            <div class="card-body" style="background: linear-gradient(135deg, #fff3e0, #ffe0b2);">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="stat-label" style="color: #fd7e14;">My Fees</p>
                        <h2 class="stat-number" style="color: #fd7e14;">৳ @due.ToString("N0")</h2>
                    </div>
                    <div class="stat-icon-wrap" style="background: linear-gradient(135deg, #fd7e14, #d63384); color: white;">
                        <i class="fa fa-money-bill-wave"></i>
                    </div>
                </div>
                <div class="detail-row">
                    <div class="detail-item">
                        <label>Due amount</label>
                        <strong class="@(due > 0 ? "text-danger" : "text-success")">৳ @due.ToString("N0")</strong>
                    </div>
                    <div class="detail-item">
                        <label>Paid</label>
                        <strong>৳ @Model.Payment.TotalPaid.ToString("N0")</strong>
                    </div>
                </div>
            </div>
            <a asp-controller="Students" asp-action="Profile" asp-route-id="@Model.Student?.UniqueId" class="stat-footer-link text-decoration-none">
                <span><i class="fa fa-arrow-right me-2"></i>Payment details</span>
                <i class="fa fa-chevron-right"></i>
            </a>
        </div>
    </div>
</div>
