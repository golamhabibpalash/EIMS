@model SMS_App.ViewModels.Testimonials.TestimonialCreateVM
@{
    ViewData["Title"] = "Add Testimonial";
    GlobalUI.PageTitle = "Add Testimonial";
}

<div class="card shadow-sm">
    <div class="card-header bg-navy-blue text-light"><h5 class="mb-0"><i class="fa fa-plus mr-2"></i> Add Testimonial</h5></div>
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="StudentId" class="form-label"></label>
                    <select asp-for="StudentId" asp-items="Model.StudentList" class="form-control select2">
                        <option value="">— External / Alumni (no student) —</option>
                    </select>
                    <span asp-validation-for="StudentId" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="StudentName" class="form-label"></label>
                    <input asp-for="StudentName" class="form-control" />
                    <span asp-validation-for="StudentName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Designation" class="form-label"></label>
                    <input asp-for="Designation" class="form-control" placeholder="e.g. Student, Class 10 / Batch 2020" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="DisplayOrder" class="form-label"></label>
                    <input asp-for="DisplayOrder" type="number" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Photo (optional)</label>
                    <input type="file" name="photoFile" accept=".jpg,.jpeg,.png" class="form-control" />
                    <small class="text-muted">Falls back to the student photo if left empty.</small>
                </div>
                <div class="col-12 mb-3">
                    <label asp-for="Content" class="form-label"></label>
                    <textarea asp-for="Content" class="form-control" rows="5" maxlength="2000"></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3 form-check ms-2">
                    <input asp-for="Status" class="form-check-input" type="checkbox" />
                    <label asp-for="Status" class="form-check-label">Active</label>
                </div>
                <div class="col-md-3 mb-3 form-check">
                    <input asp-for="IsPublished" class="form-check-input" type="checkbox" />
                    <label asp-for="IsPublished" class="form-check-label">Publish now</label>
                </div>
            </div>
            <div class="mt-2">
                <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () { if ($.fn.select2) $('.select2').select2({ theme: 'bootstrap-5', width: '100%' }); })();
    </script>
}
