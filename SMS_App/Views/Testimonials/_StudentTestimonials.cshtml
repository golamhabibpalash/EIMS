@model IEnumerable<SMS.Entities.Testimonial>
@{
    var studentId = (int)ViewBag.StudentId;
    var canManage = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h6 class="mb-0">Testimonials</h6>
    @if (canManage)
    {
        <a asp-controller="Testimonials" asp-action="Create" asp-route-studentId="@studentId" class="btn btn-sm btn-primary" target="_blank">
            <i class="fa fa-plus"></i> Add
        </a>
    }
</div>

@if (!Model.Any())
{
    <p class="text-muted small">No testimonials for this student yet.</p>
}
else
{
    <table class="table table-sm table-bordered">
        <thead class="table-light">
            <tr><th>Designation</th><th>Testimonial</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.Designation</td>
                    <td>@(t.Content != null && t.Content.Length > 70 ? t.Content.Substring(0, 70) + "…" : t.Content)</td>
                    <td>@(t.IsPublished ? Html.Raw("<span class='badge bg-primary'>Published</span>") : Html.Raw("<span class='badge bg-warning text-dark'>Draft</span>"))</td>
                    <td><a asp-controller="Testimonials" asp-action="Details" asp-route-id="@t.Id" target="_blank" class="btn btn-sm btn-outline-info"><i class="fa fa-eye"></i></a></td>
                </tr>
            }
        </tbody>
    </table>
}
