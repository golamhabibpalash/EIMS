@model SMS.Entities.Testimonial
@{
    ViewData["Title"] = "Delete Testimonial";
    GlobalUI.PageTitle = "Delete Testimonial";
}

<div class="card shadow-sm">
    <div class="card-header bg-danger text-light"><h5 class="mb-0"><i class="fa fa-trash mr-2"></i> Delete Testimonial</h5></div>
    <div class="card-body">
        <p class="text-danger">Are you sure you want to permanently delete this testimonial?</p>
        <dl class="row">
            <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.StudentName</dd>
            <dt class="col-sm-3">Designation</dt><dd class="col-sm-9">@Model.Designation</dd>
            <dt class="col-sm-3">Testimonial</dt><dd class="col-sm-9">@Model.Content</dd>
        </dl>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger"><i class="fa fa-trash"></i> Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
