@model SMS.Entities.Testimonial
@{
    ViewData["Title"] = "Testimonial Details";
    GlobalUI.PageTitle = "Testimonial Details";
    var canManage = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");
    string photo = !string.IsNullOrEmpty(Model.Photo)
        ? Url.Content($"~/Images/Testimonial/{Model.Photo}")
        : (Model.Student != null && !string.IsNullOrEmpty(Model.Student.Photo)
            ? Url.Content($"~/Images/Student/{Model.Student.Photo}")
            : Url.Content("~/Images/noProfileImage.png"));
}

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fa fa-quote-right mr-2"></i> Testimonial Details</h5>
        <div>
            @if (canManage)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary"><i class="fa fa-edit"></i> Edit</a>
            }
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back</a>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-3 text-center">
                <img src="@photo" class="rounded-circle mb-2" style="width:120px;height:120px;object-fit:cover;" />
                <h5 class="mb-0">@Model.StudentName</h5>
                <div class="text-muted">@Model.Designation</div>
                <div class="mt-2">
                    @(Model.Status ? Html.Raw("<span class='badge bg-success'>Active</span>") : Html.Raw("<span class='badge bg-secondary'>Inactive</span>"))
                    @(Model.IsPublished ? Html.Raw("<span class='badge bg-primary'>Published</span>") : Html.Raw("<span class='badge bg-warning text-dark'>Draft</span>"))
                </div>
            </div>
            <div class="col-md-9">
                <blockquote class="blockquote">
                    <p>“@Model.Content”</p>
                </blockquote>
                <dl class="row small text-muted mt-3">
                    <dt class="col-sm-3">Display Order</dt><dd class="col-sm-9">@Model.DisplayOrder</dd>
                    <dt class="col-sm-3">Created</dt><dd class="col-sm-9">@Model.CreatedAt.ToString("dd MMM yyyy") by @Model.CreatedBy</dd>
                    <dt class="col-sm-3">Last Edited</dt><dd class="col-sm-9">@Model.EditedAt.ToString("dd MMM yyyy") by @Model.EditedBy</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
