@using System.Globalization
@{
    ViewData["Title"] = "Payments Report";
    GlobalUI.PageTitle = ViewData["Title"].ToString();



    var items = new List<SelectListItem>
    {
        new SelectListItem { Text = "all", Value = "all" },
        new SelectListItem { Text = "residential", Value = "residential" },
        new SelectListItem { Text = "nonResidential", Value = "nonResidential" }
    };
}

<div class="row">
    <div class="col-md-4">
        <div class="row">
            <div class="col-md-12">
                <form asp-action="StudentPaymentReport" method="post">
                    <fieldset class="border border-info p-2">
                        <legend class="float-none w-auto text-primary px-2"
                        style="font-size: 1.1rem; position: relative;">Student Payments Details</legend>

                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Date From</label>
                            <div class="col-sm-9">
                                <input class="form-control" type="date" id="sFromDate" name="fromDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Date To</label>
                            <div class="col-sm-9">
                                <input class="form-control" type="date" id="sToDate" name="fromDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="classId" class="col-sm-3 col-form-label">Academic Class</label>
                            <div class="col-sm-9">
                                <select id="AcademicClassId" class="form-control" asp-items="ViewBag.AcademicClass">
                                    <option disabled selected value="">-Select Class-</option>
                                    <option value="">All Class-</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="classId" class="col-sm-3 col-form-label">Academic Section</label>
                            <div class="col-sm-9">
                                <select id="AcademicSectionId" class="form-control">
                                    <option value="">Section</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="classId" class="col-sm-3 col-form-label">Payment Category</label>
                            <div class="col-sm-9">
                                <select id="PaymentCategoryId" class="form-control" asp-items="@items">
                                    <option disabled selected >-Select Payment Category-</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="classId" class="col-sm-3 col-form-label">Payment Type</label>
                            <div class="col-sm-9">
                                <select id="PaymentTypeId" class="form-control" >
                                    <option disabled selected >-Select Payment Type-</option>
                                </select>
                            </div>
                        </div>
                        <div class="text-end">
                            <span id="loadReportBtn" class="btn btn-sm btn-info">Load Report</span>
                        </div>
                    </fieldset>
                </form>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12" id="InvalidForm" style="display:none">
                <div><h2 class="text-danger"> Please Select the field</h2></div>
            </div>
        </div>
    </div>
    <div class="col-md-8" id="iframe-container" style="display:none">
        <div class="row" style="height:600px;">
            <iframe id="myIframe" style="width: 100%; height: 100%;"></iframe>
        </div>
    </div>
    <div class="col-md-8 text-center" id="loading" style="display:none">
        <div class="d-flex justify-content-center h-100 align-content-center align-items-center">
            <h2 class="text-danger"><span class="spinner-border" role="status" aria-hidden="true"></span> Please wait while the data is loading...</h2>
        </div>
    </div>
</div>



@section Scripts{
    <script>
        $(document).ready(function () {
            $('#loadReportBtn').click(function () {

                $('#myIframe').attr('src', '');

                let reportType = 'pdf';
                let aSection = '0';
                let academicClassId = '0';
                let fromDate = '';
                let toDate = '';
                let paymentCategory = '';
                let paymentType = '';


                fromDate = $('#sFromDate').val();
                toDate = $('#sToDate').val();
                academicClassId = $('#AcademicClassId option:selected').val();
                aSection = $('#AcademicSectionId option:selected').val();
                paymentCategory = $('#PaymentCategoryId option:selected').val();
                paymentType = $('#PaymentTypeId option:selected').val();

                if (fromDate == '' && toDate == '') {
                    $('#InvalidForm').show();
                    $('#AcademicSessionId').focus();
                    $('#iframe-container').hide();
                    $('#loading').hide();
                }
                else {
                    $('#myIframe').attr('src', '/Reports/StudentPaymentReportExport?reportType=' + reportType + '&&fromDate=' + fromDate + '&&toDate=' + toDate + '&&academicClassId=' + academicClassId + '&&academicSectionId=' + aSection + "&&paymentCategory=" + paymentCategory + "&&paymentType=" + paymentType);

                    var iframe = document.getElementById('myIframe');
                    $('#loading').show();
                    $('#iframe-container').hide();
                    $('#InvalidForm').hide();
                    iframe.onload = function () {
                        console.log('Iframe loaded');
                        $('#loading').hide();
                        $('#iframe-container').show();
                    };

                }
            });



            $('#AcademicClassId').change(function () {
                let id = $('#AcademicClassId option:selected').val();
                let sessionId = $('#AcademicSessionId option:selected').val();

                $.ajax({
                    url: "/api/academicsections/getbyclasswithsessionId?classId=" + id + "&sessionId=" + sessionId,
                    dataType: "JSON",
                    type: "POST",
                    cache: false,
                    success: function (data) {
                        $('#AcademicSectionId').empty();

                        if (data != null || data != '') {
                            var o = '<option disabled selected value="">Select Section Name</option>';
                            var o2 = '<option value="">All Section</option>';
                            $('#AcademicSectionId').append(o);
                            $('#AcademicSectionId').append(o2);
                            $.each(data, function (i, obj) {
                                console.log(obj.name);
                                var op = '<option value="' + obj.id + '">' + obj.name + '</option>';
                                $('#AcademicSectionId').append(op);
                            });
                        }
                        else {
                            var o = '<option disabled selected>Section Not Found</option>';
                            $('#AcademicSectionId').append(o);
                        }
                    },
                    error: function (err) {
                        console.log(err);
                    }
                });
            });


            $('#PaymentCategoryId').change(function () {
                let isResidential = $('#PaymentCategoryId option:selected').val();
                $.ajax({
                    url: "/studentFeeHeads/GetFeeHeads?isResidential=" + isResidential,
                    dataType: "JSON",
                    type: "POST",
                    cache: false,
                    success: function (data) {
                        $('#PaymentTypeId').empty();

                        if (data != null || data != '') {
                            var o = '<option disabled selected value="">Select Payment Type</option>';
                            var o2 = '<option value="">All Type</option>';
                            $('#PaymentTypeId').append(o);
                            $('#PaymentTypeId').append(o2);
                            $.each(data, function (i, obj) {
                                console.log(obj.name);
                                var op = '<option value="' + obj.id + '">' + obj.name + '</option>';
                                $('#PaymentTypeId').append(op);
                            });
                        }
                        else {
                            var o = '<option disabled selected>Section Not Found</option>';
                            $('#AcademicSectionId').append(o);
                        }
                    },
                    error: function (err) {
                        console.log(err);
                    }
                });
            });
        });

    </script>
}