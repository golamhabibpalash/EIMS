@model SMS_App.ViewModels.Students.StudentCreateVM

@{
    ViewData["Title"] = "Add New Student";
    GlobalUI.PageTitle = ViewBag.Title;
    var dobMaxDate = DateTime.Now;
}
@if (ViewBag.msg != null)
{
    <span class="fadeOutMsg alert alert-danger">@ViewBag.msg</span>
}
<div class="row">
    <div class="col-md-12">
        <form asp-action="Create" asp-controller="Students" enctype="multipart/form-data">
            @Html.AntiForgeryToken();
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div class="row">
                <div class="col-md-10 offset-md-2">
                    <h6 class="alert alert-heading alert-info">Academic Information</h6>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="AcademicSessionId" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <div class="input-group mb-3">
                        <select asp-for="AcademicSessionId" class="form-control input-sm" asp-items="Model.AcademicSessionList">
                            <option disabled selected value="">Select Academic Session</option>
                        </select>
                        <div class="input-group-append">
                            <a asp-controller="AcademicSessions" asp-action="Create" class="btn btn-outline-secondary btn-sm" title="Create New Session">
                                <span class="fa fa-plus"></span>
                            </a>
                        </div>
                        <span asp-validation-for="AcademicSessionId" class="text-danger"></span>
                    </div>
                </div>
                
                <label asp-for="AcademicClassId" class="col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">

                    <div class="input-group mb-3">
                        <select asp-for="AcademicClassId" class="form-control input-sm" asp-items="Model.AcademicClassList">
                            <option disabled selected value="">Select Academic Class</option>
                        </select>
                        <div class="input-group-append">
                            <a asp-controller="AcademicClasses" asp-action="Create" class="btn btn-outline-secondary btn-sm" title="Create New Class">
                                <span class="fa fa-plus"></span>
                            </a>
                        </div>
                    </div>
                    <span asp-validation-for="AcademicClassId" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="AcademicSectionId" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">

                    <div class="input-group mb-3">
                        <select asp-for="AcademicSectionId" class="form-control input-sm">
                            <option disabled selected>Select Class First</option>
                            <option value="">No Section</option>
                        </select>
                        <div class="input-group-append">
                            <a asp-controller="AcademicSections" asp-action="Create" class="btn btn-outline-secondary btn-sm btn-md" title="Create New Section">
                                <span class="fa fa-plus"></span>
                            </a>
                        </div>
                    </div>
                    <span asp-validation-for="AcademicSectionId" class="text-danger"></span>
                </div>

                <label asp-for="ClassRoll" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <input asp-for="ClassRoll" placeholder="Input Class roll" class="form-control input-sm" required max="999" min="1" onchange="classRollChnaged()" />
                    <span asp-validation-for="ClassRoll" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="AdmissionDate" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <input asp-for="AdmissionDate" class="form-control" value="@DateTime.Now.Date.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="AdmissionDate" class="text-danger"></span>
                </div>

                <div class="checkbox offset-md-2 col-md-4 text-md-start">
                    <label class="col-form-label"><input asp-for="IsResidential"> Residential</label>
                </div>
            </div>

            <div class="form-group row">
                <label asp-for="UniqueId" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <input asp-for="UniqueId" class="form-control" disabled />
                    <span asp-validation-for="UniqueId" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-10 offset-md-2">
                    <h6 class="alert alert-heading alert-info">Personal Information</h6>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="Name" class="col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <label asp-for="FatherName" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <input asp-for="FatherName" class="form-control" />
                    <span asp-validation-for="FatherName" class="text-danger"></span>
                </div>

            </div>
            <div class="form-group row">
                <label asp-for="NameBangla" class="col-form-label text-md-end col-md-2"></label>
                <div class="col-md-10">
                    <input asp-for="NameBangla" class="form-control" />
                    <span asp-validation-for="NameBangla" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="Photo" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <div class="row">
                        <div class="col-md-6">
                            <input type="file" name="sPhoto" class="form-control-plaintext" id="imgInp" />
                        </div>
                        <div class="col-md-6" id="photoDiv" style="display:none">
                            <img id="sPhotoId" style="width:100px; border:1px solid black" />
                        </div>
                    </div>
                    <span asp-validation-for="Photo" class="text-danger"></span>
                </div>


                <label asp-for="MotherName" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <input asp-for="MotherName" class="form-control" />
                    <span asp-validation-for="MotherName" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="Email" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <label asp-for="GuardianPhone" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <input asp-for="GuardianPhone" class="form-control" />
                    <span asp-validation-for="GuardianPhone" class="text-danger"></span>
                </div>

            </div>
            <div class="form-group row">
                <label asp-for="PhoneNo" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <input asp-for="PhoneNo" class="form-control" maxlength="11" />
                    <span asp-validation-for="PhoneNo" class="text-danger"></span>
                </div>

                <label asp-for="BirthCertificateNo" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <input asp-for="BirthCertificateNo" class="form-control" />
                    <span asp-validation-for="BirthCertificateNo" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row">
                <label asp-for="DOB" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <input asp-for="DOB" class="form-control" max="@dobMaxDate.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="DOB" class="text-danger"></span>
                </div>

                <label asp-for="BirthCertificateImage" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <input type="file" name="DOBFile" class="form-control-plaintext" />
                    <span asp-validation-for="BirthCertificateImage" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="GenderId" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <select asp-for="GenderId" class="form-control" asp-items="Model.GenderList">
                        <option selected disabled>Select Gender</option>
                    </select>
                    <span asp-validation-for="GenderId" class="text-danger"></span>
                </div>

                <label asp-for="NationalityId" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <select asp-for="NationalityId" class="form-control" asp-items="Model.NationalityList">
                        <option selected disabled>Select Nationality</option>
                    </select>
                    <span asp-validation-for="NationalityId" class="text-danger"></span>
                </div>

            </div>
            <div class="form-group row">
                <label asp-for="BloodGroupId" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <select asp-for="BloodGroupId" class="form-control" asp-items="Model.BloodGroupList">
                        <option selected disabled>Select Blood Group</option>
                        <option value="">N/A</option>
                    </select>
                    <span asp-validation-for="BloodGroupId" class="text-danger"></span>
                </div>
                <label asp-for="ReligionId" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <select asp-for="ReligionId" class="form-control" asp-items="Model.ReligionList">
                        <option selected disabled>Select Religion</option>
                    </select>
                    <span asp-validation-for="ReligionId" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-10 offset-2">
                    <h6 class="alert alert-heading alert-info">Present Address Information</h6>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="PresentAddressArea" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <input asp-for="PresentAddressArea" class="form-control" />
                    <span asp-validation-for="PresentAddressArea" class="text-danger"></span>
                </div>

                <label asp-for="PresentAddressPO" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <input asp-for="PresentAddressPO" class="form-control" />
                    <span asp-validation-for="PresentAddressPO" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="PresentDivisionId" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <select asp-for="PresentDivisionId" class="form-control" asp-items="Model.DivisionList" style="width:100%;">
                        <option disabled selected>Select Division Name</option>
                    </select>
                    <span asp-validation-for="PresentDivisionId" class="text-danger"></span>
                </div>

                <label asp-for="PresentDistrictId" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <select asp-for="PresentDistrictId" class="form-control" style="width:100%;">
                        <option disabled selected>Select Division First</option>
                    </select>
                    <span asp-validation-for="PresentDistrictId" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="PresentUpazilaId" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <select asp-for="PresentUpazilaId" class="form-control " style="width:100%;">
                        <option disabled selected>Select District First</option>
                    </select>
                    <span asp-validation-for="PresentUpazilaId" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-10 offset-md-2">
                    <h6 class="alert alert-heading alert-info">Permanent Address Information <span>(<input type="checkbox" id="sameAddress" /> <label for="sameAddress">Same as Present Address</label> )</span></h6>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="PermanentAddressArea" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <input asp-for="PermanentAddressArea" class="form-control" />
                    <span asp-validation-for="PermanentAddressArea" class="text-danger"></span>
                </div>

                <label asp-for="PermanentAddressPO" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <input asp-for="PermanentAddressPO" class="form-control" />
                    <span asp-validation-for="PermanentAddressPO" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="PermanentDivisionId" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <select asp-for="PermanentDivisionId" class="form-control " asp-items="Model.DivisionList" style="width:100%;">
                        <option disabled selected>Select Division Name</option>
                    </select>
                    <span asp-validation-for="PermanentDivisionId" class="text-danger"></span>
                </div>

                <label asp-for="PermanentDistrictId" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <select asp-for="PermanentDistrictId" class="form-control" style="width:100%;">
                        <option disabled selected>Select Division First</option>
                    </select>
                    <span asp-validation-for="PermanentDistrictId" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="PermanentUpazilaId" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-4">
                    <select asp-for="PermanentUpazilaId" class="form-control " style="width:100%;">
                        <option disabled selected>Select District First</option>
                    </select>
                    <span asp-validation-for="PermanentUpazilaId" class="text-danger"></span>
                </div>

            </div>
            <div class="form-group row">
                <label asp-for="AddressInfo" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-10">
                    <input asp-for="AddressInfo" class="form-control" />
                    <span asp-validation-for="AddressInfo" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="PreviousSchool" class="control-label col-form-label text-md-end col-md-2"></label>
                <div class="col-md-10">
                    <input asp-for="PreviousSchool" class="form-control" />
                    <span asp-validation-for="PreviousSchool" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-10 offset-md-2">
                    <h6 class="alert alert-heading alert-info">Other's Information </h6>
                </div>
            </div>
            <div class="form-group row">
                <label class="col-form-label col-md-4 offset-md-2">
                    <input class="" asp-for="SMSService" /> @Html.DisplayNameFor(model => model.SMSService)
                </label>
            </div>
            <div class="form-group row">
                <label class="col-form-label col-md-4 offset-md-2">
                    <input class="" asp-for="Status" /> @Html.DisplayNameFor(model => model.Status)
                </label>
            </div>
            <div class="form-group row ">
                <div class="col-md-8 offset-md-2">
                    <partial name="_Create_Back" />
                </div>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}


    <script src="~/js/Student/Create.js"></script>
}
