@model SMS.Entities.AdditionalModels.StudentVM.ProfileDocument


<div class="tab-pane fade" id="documents" role="tabpanel" aria-labelledby="documents-tab">
    
    <div class="card shadow-sm" style="display:none">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Documents</h5>
            <button class="btn btn-sm btn-light">
                <i class="bi bi-upload me-2"></i>Upload New
            </button>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="card border">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0">
                                    <i class="bi bi-file-earmark-pdf text-danger" style="font-size: 2rem;"></i>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="mb-1">Admission Letter</h6>
                                    <p class="text-muted small mb-2">Uploaded: Sep 1, 2022</p>
                                    <p class="text-muted small mb-0">Size: 245 KB</p>
                                </div>
                                <div class="flex-shrink-0">
                                    <button class="btn btn-sm btn-outline-primary me-1"><i class="bi bi-eye"></i></button>
                                    <button class="btn btn-sm btn-outline-success"><i class="bi bi-download"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                @if (Model.Documents!=null && Model.Documents.Count()>0)
                {
                    foreach(var doc in Model.Documents)
                    {
                        <div class="col-md-6 mb-3">
                            <div class="card border">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="flex-shrink-0">
                                            <i class="bi bi-file-earmark-pdf text-danger" style="font-size: 2rem;"></i>
                                        </div>
                                        <div class="flex-grow-1 ms-3">
                                            <h6 class="mb-1">@doc.DocumentName</h6>
                                            <p class="text-muted small mb-2">Uploaded: Sep 15, 2022</p>
                                            <p class="text-muted small mb-0">Size: 180 KB</p>
                                        </div>
                                        <div class="flex-shrink-0">
                                            <button class="btn btn-sm btn-outline-primary me-1"><i class="bi bi-eye"></i></button>
                                            <button class="btn btn-sm btn-outline-success"><i class="fa fa-download"></i></button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                    }
                }
                else
                {
                    <span class="alert alert-warning text-center">Document Not Found</span>
                }
            </div>
        </div>
    </div>
</div>