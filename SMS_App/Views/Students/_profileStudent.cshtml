@model SMS.Entities.Student

@{
    string userImage = "/Images/Student/" + Model.Photo;
    string errorImage = Model.GenderId == 1 ? "/images/employee/photo/maleemployee.png" : "/images/employee/photo/femaleemployee.png";
    string studentStatus = Model.Status == true ? "Active" : "Inactive";
}

<div class="card shadow-sm overflow-hidden">
    <div class="card-body text-center p-0">
        <img src="@userImage" class="rounded-circle mb-3" alt="Student Photo" width="150" height="150" onerror="this.src='@errorImage'">

        <h4 class="mb-1">@Model.Name</h4>
        <p class="text-muted mb-2">Student ID: @Model.UniqueId</p>

        <hr>

        <div class="text-start">
            <table class="table table-borderless table-sm">
                <tbody>
                    <tr class="border-bottom">
                        <td class="fw-bold text-nowrap" style="width:40%">
                            <i class="bi bi-envelope me-2 text-primary"></i>Class Roll
                        </td>
                        <td class="text-muted">@Model.ClassRoll</td>
                    </tr>
                    <tr class="border-bottom">
                        <td class="fw-bold text-nowrap" style="width:40%">
                            <i class="bi bi-envelope me-2 text-primary"></i>Email
                        </td>
                        <td class="text-muted">@Model.Email</td>
                    </tr>
                    <tr class="border-bottom">
                        <td class="fw-bold text-nowrap">
                            <i class="bi bi-telephone me-2 text-primary"></i>Phone
                        </td>
                        <td class="text-muted">@Model.PhoneNo.ToString().PadLeft(11, '0')</td>
                    </tr>
                    <tr class="border-bottom">
                        <td class="fw-bold text-nowrap">
                            <i class="bi bi-telephone me-2 text-primary"></i>Guardian
                        </td>
                        <td class="text-muted">@Model.GuardianPhone.ToString().PadLeft(11, '0')</td>
                    </tr>
                    <tr class="border-bottom">
                        <td class="fw-bold text-nowrap">
                            <i class="bi bi-calendar me-2 text-primary"></i>Date of Birth
                        </td>
                        <td class="text-muted">@Model.DOB.ToString("MMM dd, yyyy")</td>
                    </tr>
                    <tr class="border-bottom">
                        <td class="fw-bold text-nowrap">
                            <i class="bi bi-book me-2 text-primary"></i>Class
                        </td>
                        <td class="text-muted">@Model.AcademicClass.Name</td>
                    </tr>
                    <tr class="border-bottom">
                        <td class="fw-bold text-nowrap">
                            <i class="bi bi-mortarboard me-2 text-primary"></i>Section
                        </td>
                        <td class="text-muted">@Model.AcademicSection?.Name</td>
                    </tr>
                    <tr class="border-bottom">
                        <td class="fw-bold text-nowrap">
                            <i class="bi bi-mortarboard me-2 text-primary"></i>Status
                        </td>
                        <td class="fw-bold @(studentStatus == "Active" ? "text-success" : "text-danger")">
                            @studentStatus
                        </td>
                    </tr>
                    <tr class="border-bottom">
                        <td class="fw-bold text-nowrap">
                            <i class="bi bi-mortarboard me-2 text-primary"></i>Address
                        </td>
                        <td class="">
                            @Model.PresentAddressArea,@Model.PresentAddressPO, @Model.PresentDistrict?.Name, @Model.PresentDivision?.Name
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>