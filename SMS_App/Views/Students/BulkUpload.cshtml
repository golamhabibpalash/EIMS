@model SMS_App.ViewModels.Students.StudentBulkUploadVM
@using SMS.Entities.AdditionalModels.StudentImport

@{
    ViewData["Title"] = "Bulk Student Upload";
    GlobalUI.PageTitle = ViewData["Title"].ToString();
    var result = Model.Result;
    var commit = Model.CommitResult;
}

@if (ViewBag.msg != null)
{
    <div class="alert alert-danger">@ViewBag.msg</div>
}
@if (TempData["create"] != null)
{
    <div class="alert alert-success">@TempData["create"]</div>
}

@* ---------------- Step 3: what was imported ---------------- *@
@if (commit != null)
{
    <div class="card mb-3">
        <div class="card-header bg-success text-white">
            <strong>Import complete</strong>
        </div>
        <div class="card-body">
            <p class="mb-2">
                <strong>@commit.StudentsCreated</strong> student(s) created,
                <strong>@commit.AccountsCreated</strong> login(s) generated.
                No SMS was sent.
            </p>

            @if (commit.Credentials.Any())
            {
                <a asp-action="DownloadImportCredentials" asp-controller="Students" class="btn btn-primary btn-sm mb-3">
                    <span class="fa fa-download"></span> Download logins (CSV)
                </a>
                <div class="alert alert-warning py-2">
                    These passwords are shown once. Download them now &mdash; they cannot be recovered later.
                </div>

                <div class="table-responsive" style="max-height:320px; overflow:auto;">
                    <table class="table table-sm table-striped table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Roll</th>
                                <th>User Name</th>
                                <th>Password</th>
                                <th>Phone</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in commit.Credentials)
                            {
                                <tr>
                                    <td>@c.Name</td>
                                    <td>@c.ClassRoll</td>
                                    <td><code>@c.UserName</code></td>
                                    <td><code>@c.Password</code></td>
                                    <td>@c.PhoneNo</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (commit.Failures.Any())
            {
                <h6 class="mt-3 text-danger">Logins that could not be created</h6>
                <ul class="mb-0">
                    @foreach (var f in commit.Failures)
                    {
                        <li>@f.Message</li>
                    }
                </ul>
            }
        </div>
    </div>

    <a asp-action="Index" asp-controller="Students" class="btn btn-secondary btn-sm">Back to student list</a>
    <a asp-action="BulkUpload" asp-controller="Students" class="btn btn-outline-primary btn-sm">Import another file</a>
}
else
{
    @* ---------------- Step 1: upload ---------------- *@
    <div class="card mb-3">
        <div class="card-header">
            <strong>Upload a roster file</strong>
        </div>
        <div class="card-body">
            <form asp-action="BulkUpload" asp-controller="Students" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="row align-items-end">
                    <div class="col-md-6">
                        <label class="form-label">Roster file (.csv or .xlsx)</label>
                        <input type="file" name="uploadFile" class="form-control" accept=".csv,.xlsx" required />
                    </div>
                    <div class="col-md-6 mt-2 mt-md-0">
                        <button type="submit" class="btn btn-primary">
                            <span class="fa fa-upload"></span> Upload &amp; preview
                        </button>
                        <a asp-action="DownloadTemplate" asp-controller="Students" class="btn btn-outline-secondary">
                            <span class="fa fa-download"></span> Download template
                        </a>
                    </div>
                </div>
            </form>

            <hr />
            <p class="mb-1"><strong>How it works</strong></p>
            <ol class="mb-2">
                <li>Download the template and fill in one row per student.</li>
                <li>Upload it here &mdash; nothing is saved until you confirm the preview.</li>
                <li>Fix any rows flagged in red, then confirm to import.</li>
            </ol>
            <p class="mb-1">
                Write <strong>names, not ID numbers</strong>, for Class, Section, Session, Religion,
                Gender, Nationality, Blood Group, Division, District and Upazila &mdash;
                for example <code>Six</code>, <code>Islam</code>, <code>Male</code>, <code>Dhaka</code>.
            </p>
            <p class="mb-1">Dates are best written as <code>yyyy-MM-dd</code>, e.g. <code>2012-03-14</code>.</p>
            <p class="mb-0">
                Each imported student gets a login automatically.
                <strong>No SMS is sent</strong> &mdash; download the password list at the end instead.
            </p>

            @if (Model.TemplateColumns != null && Model.TemplateColumns.Any())
            {
                <details class="mt-3">
                    <summary>Expected columns (@Model.TemplateColumns.Count)</summary>
                    <div class="mt-2">
                        @foreach (var col in Model.TemplateColumns)
                        {
                            <span class="badge bg-light text-dark border me-1 mb-1">@col</span>
                        }
                    </div>
                </details>
            }
        </div>
    </div>

    @* ---------------- Step 2: preview ---------------- *@
    @if (result != null)
    {
        if (result.HasFileIssues)
        {
            <div class="alert alert-danger">
                <strong>The file could not be processed:</strong>
                <ul class="mb-0 mt-2">
                    @foreach (var issue in result.FileIssues)
                    {
                        <li>@issue.Message</li>
                    }
                </ul>
            </div>
        }
        else
        {
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Preview &mdash; @Model.OriginalFileName</strong>
                    <span>
                        <span class="badge bg-success">@result.ValidRows ready</span>
                        @if (result.InvalidRows > 0)
                        {
                            <span class="badge bg-danger">@result.InvalidRows with errors</span>
                        }
                        <span class="badge bg-secondary">@result.TotalRows total</span>
                    </span>
                </div>
                <div class="card-body">

                    @if (result.UnknownColumns.Any())
                    {
                        <div class="alert alert-warning py-2">
                            These columns were not recognised and will be ignored:
                            <strong>@string.Join(", ", result.UnknownColumns)</strong>
                        </div>
                    }

                    @if (result.InvalidRows > 0)
                    {
                        <div class="alert alert-danger py-2">
                            <strong>@result.InvalidRows row(s) will be skipped.</strong>
                            Correct them in your file and upload again if you need them imported.
                        </div>
                    }

                    <div class="table-responsive" style="max-height:460px; overflow:auto;">
                        <table class="table table-sm table-bordered table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:60px;">Row</th>
                                    <th style="width:70px;">Status</th>
                                    <th>Name</th>
                                    <th>Class</th>
                                    <th>Section</th>
                                    <th>Roll</th>
                                    <th>Student ID</th>
                                    <th>Phone</th>
                                    <th>Problems</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in result.Rows)
                                {
                                    <tr class="@(row.IsValid ? "" : "table-danger")">
                                        <td>@row.RowNumber</td>
                                        <td>
                                            @if (row.IsValid)
                                            {
                                                <span class="badge bg-success">OK</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Error</span>
                                            }
                                        </td>
                                        <td>@row.Name</td>
                                        <td>@row.ClassName</td>
                                        <td>@row.SectionName</td>
                                        <td>@(row.GeneratedRoll > 0 ? row.GeneratedRoll.ToString() : row.ProvidedRoll.ToString())</td>
                                        <td>@row.UniqueId</td>
                                        <td>@row.PhoneNo</td>
                                        <td>
                                            @if (row.Issues.Any())
                                            {
                                                <ul class="mb-0 ps-3">
                                                    @foreach (var issue in row.Issues)
                                                    {
                                                        <li class="@(issue.Level == ImportIssueLevel.Error ? "text-danger" : "text-warning")">
                                                            <strong>@issue.Column</strong>
                                                            @if (!string.IsNullOrEmpty(issue.Value))
                                                            {
                                                                <text>(&ldquo;@issue.Value&rdquo;)</text>
                                                            }
                                                            &mdash; @issue.Message
                                                            @if (!string.IsNullOrEmpty(issue.Suggestion))
                                                            {
                                                                <em>Did you mean &ldquo;@issue.Suggestion&rdquo;?</em>
                                                            }
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (result.CanImport)
                {
                    <div class="card-footer">
                        <form asp-action="BulkUploadConfirm" asp-controller="Students" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="fileToken" value="@Model.FileToken" />
                            <input type="hidden" name="originalFileName" value="@Model.OriginalFileName" />
                            <button type="submit" class="btn btn-success"
                                    onclick="return confirm('Import @result.ValidRows student(s)? This also creates a login for each of them.');">
                                <span class="fa fa-check"></span> Confirm &amp; import @result.ValidRows student(s)
                            </button>
                            <a asp-action="BulkUpload" asp-controller="Students" class="btn btn-outline-secondary">Cancel</a>
                        </form>
                    </div>
                }
            </div>
        }
    }
}
