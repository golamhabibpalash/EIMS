@using SMS.Entities.AdditionalModels.StudentVM
@model StudentProfileVM
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}
@{
    ViewData["Title"] = "Profile ("+Model.Student.Name+")";
    GlobalUI.PageTitle = ViewBag.Title;
}

<div class="container-fluid py-4">
    <div class="row">
        <!-- Profile Sidebar -->
        <div class="col-lg-3 mb-4 profile-sidebar">
            <partial name="_profileStudent" model="Model.Student" />
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">
            <!-- Navigation Tabs -->
            <ul class="nav nav-tabs mb-4" id="profileTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="attendance-tab" data-bs-toggle="tab" data-bs-target="#attendance" type="button" role="tab" aria-controls="attendance" aria-selected="true" >
                        <i class="bi bi-calendar-check me-2"></i>Attendance
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="results-tab" data-bs-toggle="tab" data-bs-target="#results" type="button" role="tab" aria-controls="results" aria-selected="false" onclick="resultTabClicked()">
                        <i class="bi bi-trophy me-2"></i>Results
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="payment-tab" data-bs-toggle="tab" data-bs-target="#payment" type="button" role="tab" aria-controls="payment" aria-selected="false">
                        <i class="bi bi-credit-card me-2"></i>Payment
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="documents-tab" data-bs-toggle="tab" data-bs-target="#documents" type="button" role="tab" aria-controls="documents" aria-selected="false">
                        <i class="bi bi-file-earmark-text me-2"></i>Documents
                    </button>
                </li>
            </ul>

            <!-- Tab Content -->
            <div class="tab-content" id="profileTabsContent">
                <!-- Attendance Tab -->
                <partial name="_profileAttendance" model="Model.Attendances" />
                

                <!-- Results Tab -->
                <partial name="_profileResult" model="Model.Results" />

                <!-- Payment Tab -->
                <partial name="_profilePayment" model="Model.Payments" />

                <!-- Documents Tab -->
                <partial name="_profileDocuments" model="Model.Documents" />
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 10px;
        }

        .nav-tabs .nav-link {
            color: #495057;
            font-weight: 500;
        }

            .nav-tabs .nav-link.active {
                color: #0d6efd;
                font-weight: 600;
            }

        .progress {
            border-radius: 5px;
        }

        .table th {
            font-weight: 600;
        }

        .card-header h5 {
            font-weight: 600;
        }

        /* make sidebar sticky on desktop */
        @@media (min-width: 992px) {
            .profile-sidebar {
                position: -webkit-sticky;
                position: sticky;
                top: 20px; /* adjust as needed to account for fixed navbars/header */
            }
        }
    </style>
}
@section Scripts{

    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <script>
        function resultTabClicked(){
            var currentRank = @Model.Results.CurrentClassRank;

            if (currentRank === 1) {
                fireConfetti();
            }
            else{
                return;
            }
        }
        function fireConfetti() {
                let duration = 3000; // 3 seconds
                let end = Date.now() + duration;

                (function frame() {
                    confetti({
                        particleCount: 5,
                        spread: 70,
                        origin: { y: 0.6 }
                    });

                    if (Date.now() < end) {
                        requestAnimationFrame(frame);
                    }
                })();
            }
    </script>
}