@model SMS.Entities.AdditionalModels.StudentVM.ProfileAttendance

<div class="tab-pane fade show active" id="attendance" role="tabpanel" aria-labelledby="attendance-tab">
    <div class="alert alert-info">@Model.TodaysAttendance</div>
    <div class="card shadow-sm mb-4">
        <br />
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Attendance Overview (@Model.CurrentSession.Name)</h5>
        </div>
        <div class="card-body">
            <div class="row text-center mb-4">
                <div class="col-md-3">
                    <div class="border rounded p-3">
                        <h3 class="text-success mb-1">@Model.OverallAttendance%</h3>
                        <p class="text-muted mb-0 small">Overall Attendance</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3">
                        <h3 class="text-primary mb-1">@Model.DaysPresent</h3>
                        <p class="text-muted mb-0 small">Days Present</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3">
                        <h3 class="text-warning mb-1">@Model.DaysAbsent</h3>
                        <p class="text-muted mb-0 small">Days Absent</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3">
                        <h3 class="text-info mb-1">@Model.LateArrivals</h3>
                        <p class="text-muted mb-0 small">Late Arrivals</p>
                    </div>
                </div>
            </div>

            <h6 class="mb-3">Monthly Attendance</h6>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Month</th>
                            <th>Total Days</th>
                            <th>Present</th>
                            <th>Absent</th>
                            <th>Late</th>
                            <th>Percentage</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if(Model.MonthlyAttendances!=null && Model.MonthlyAttendances.Count>0)
                        {
                            foreach (var att in Model.MonthlyAttendances)
                            {
                            <tr>
                                <td>@att.MonthName</td>
                                <td>@att.TotalDays</td>
                                <td>@att.DaysPresent</td>
                                <td>@att.DaysAbsent</td>
                                <td>@att.LateArrivals</td>
                                <td>
                                    <div class="progress" style="height: 20px;">
                                            <div class="progress-bar bg-danger" role="progressbar" style="width: @att.Percentage%">@att.Percentage %</div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge" style="color:@att.StatusColor ">@att.Status</span>
                                </td>
                            </tr> 
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>