@using Microsoft.AspNetCore.Identity;
@using System.IO;
@using SMS_App.Utilities.Pagination;
@using SMS_App.Utilities.Export;
@using Microsoft.AspNetCore.Hosting;
@using System.Globalization;

@inject UserManager<ApplicationUser> _userManager;
@inject IWebHostEnvironment env;

@model PaginatedList<SMS.Entities.AdditionalModels.StudentListVM>

@{
    ViewData["Title"] = "Students";
    GlobalUI.PageTitle = ViewBag.Title;
    // The list is fully described by its own URL (filters, search, sort, page, page size).
    // Hand that URL to the row action links so Edit/Details/Delete/Create can return to
    // exactly this filtered view after an operation.
    var listReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    ViewData["ListReturnUrl"] = listReturnUrl;
    string totalFound = ViewBag.totalFound == null ? "Nothing Found" : ViewBag.totalFound + " Found";
    TextInfo textInfo = new CultureInfo("en-US", false).TextInfo;
    string name = string.Empty;
    int pSize = Convert.ToInt32(ViewData["pageSize"]);
    int tFound = Convert.ToInt32(ViewBag.totalFound);
    int showingCount = 0;
    if (tFound < pSize)
    {
        showingCount = tFound;
    }
    else
    {
        showingCount = Convert.ToInt32(ViewData["pageSize"]);
    }
}


<div class="row">
    <form asp-controller="Students" asp-action="Index" class="" id="FilterForm" method="get">
        <section class="bg-navy-blue p-2 pt-4">
            <input type="hidden" name="pageSize" value="" id="pageSizeHiddenId" />
            <div class="form-group row">
                <label for="aAcademicSessionId" class="col-md-1 col-sm-2 col-form-label text-lg-right">Academic
                    Session</label>
                <div class="col-md-3 col-sm-4">
                    <select class="form-control" name="AcademicSessionId" id="aAcademicSessionId"
                        asp-items="@ViewBag.academicSessionId">
                    </select>
                </div>
                <label for="aAcademicClassId" class="col-md-1 col-sm-2 col-form-label text-lg-right">Academic
                    Class</label>
                <div class="col-md-3 col-sm-4">
                    <select class="form-control" name="AcademicClassId" id="aAcademicClassId"
                        asp-items="@ViewBag.academicClassId">
                        <option value="">Select Academic Class Option</option>
                    </select>
                </div>
                <label for="aAcademicSectionId" class="col-md-1 col-sm-2 col-form-label text-lg-right">Academic
                    Section</label>
                <div class="col-md-3 col-sm-4">
                    <select class="form-control" id="aAcademicSectionId" name="AcademicSectionId"
                        asp-items="ViewBag.SectionList">
                        <option value="">Select Academic Class first</option>
                    </select>
                </div>
            </div>

            <div class="form-group row">
                <label for="inputPassword" class="col-md-1 col-sm-2 col-form-label text-md-end">keyword search</label>
                <div class="col-md-3 col-sm-4">
                    <input type="text" class="form-control" name="searchString" id="nameRoll"
                        placeholder="Search By Name/Roll/Unique ID/ Phone" value="@ViewData["searchString"]">
                </div>
                <label for="aAcademicSectionId" class="col-md-1 col-sm-2 col-form-label text-lg-right">Student
                    Category</label>
                <div class="col-md-3 col-sm-4">
                    <select class="form-control" id="aCategoryId" name="aCategory" asp-items="ViewBag.aCategory">
                        <option value="">Select Category Option</option>
                    </select>
                </div>
                <label for="aStatusType" class="col-md-1 col-sm-2 col-form-label text-lg-right">Status Type</label>
                <div class="col-md-3 col-sm-4">
                    <select class="form-control" name="aStatus" id="aStatusType" asp-items="ViewBag.aStatus">
                        <option value="">Type of Student</option>
                    </select>
                </div>
            </div>
            <div class="form-group row justify-content-center">
                <div class="col-md-3 col-sm-4 text-right">
                    <button type="button" class="btn btn-sm btn-block form-control btn-light col-md-6"
                        id="findButton"><i class="fa fa-search"></i> Find</button>
                </div>
                <div class="col-md-3 col-sm-4 text-right"><a
                        class="btn btn-sm  btn-warning form-control text-success col-md-5" asp-action="Index" asp-route-reset="true">Reset</a>
                </div>
                <div class="col-md-2 text-md-start col-form-label">
                    <span>(Showing @showingCount of @ViewBag.totalFound)</span>
                </div>
            </div>
        </section>
        @if (Model.Count <= 0)
        {
            <div class="row text-center">
                <h3 class="text-center mt-5">Student not found</h3>
                <a asp-action="Create" asp-route-returnUrl="@listReturnUrl" class="p-2 btn-sm btn-info rounded-pill">
                    <i class="fa fa-plus"></i> Add <i class="fa fa-user-alt"></i>
                </a>
                <h3 class="text-center">You are searching by <span class="text-danger" id="searchParameter"></span></h3>
            </div>
        }
        else
        {
            <table class="table table-hover table-bordered table-responsive-sm table-striped" id="">
                <thead class="bg-blue text-light">
                    <tr>
                        <td width="2%">Photo</td>
                        <th width="3%" class="text-nowrap">Unique ID</th>
                        <th width="4%">
                            <a class="text-light" asp-action="Index" asp-route-pageSize="@ViewData["pageSize"]"
                                asp-route-sortOrder="@ViewData["rollSortParam"]"
                                asp-route-currentFilter="@ViewData["CurrentFilter"]"> Class Roll <i
                                    class="fa fa-sort"></i></a>
                        </th>
                        <th width="10%"> Name</th>
                        <th width="5%">নাম </th>
                        <th width="5%"> <a class="text-light" asp-action="Index" asp-route-pageSize="@ViewData["pageSize"]"
                                asp-route-sortOrder="@ViewData["academicClassSortParam"]"
                                asp-route-currentFilter="@ViewData["CurrentFilter"]"> Class <i class="fa fa-sort"></i></a>
                        </th>
                        <th width="5%"> Section </th>
                        <th width="5%">Student PhoneNo</th>
                        <th width="5%"> Guardian PhoneNo</th>
                        <th width="5%">Session </th>
                        <th width="5%">Gender </th>
                        <th width="5%">Status</th>
                        <th width="5%"><a asp-action="Create" asp-route-returnUrl="@listReturnUrl" class="p-2 btn-sm btn-info rounded-pill"><i
                                    class="fa fa-plus"></i> Add <i class="fa fa-user-alt"></i> </a>
                            <a asp-action="BulkUpload" class="p-2 btn-sm btn-secondary rounded-pill"
                               title="Import many students from a CSV or Excel file"><i
                                    class="fa fa-upload"></i> Bulk</a></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="p-1">
                                <a asp-action="Details" asp-route-id="@item.Id" asp-controller="Students">
                                    @{
                                        var avatar = "/Images/noProfileImage.png";
                                        if (!string.IsNullOrEmpty(item.Photo))
                                        {
                                            var path = System.IO.Path.Combine(env.WebRootPath, "Images/Student/", item.Photo);
                                            if (File.Exists(path))
                                            {
                                                // Append the file's last-write time so an updated photo (which reuses the
                                                // same filename) is fetched fresh instead of from the browser cache.
                                                avatar = $"/Images/Student/{item.Photo}?v={System.IO.File.GetLastWriteTimeUtc(path).Ticks}";
                                            }
                                        }
                                    }
                                    <span>
                                        <img src=@avatar alt="@item.StudentName"
                                            style="max-width:30px; max-height:30px; border-radius:50%;" />
                                    </span>
                                </a>
                            </td>
                            <td class="p-1">
                                <span>
                                    @item.UniqueId
                                </span>
                            </td>
                            <td class="p-1">
                                <span>
                                    @Html.DisplayFor(modelItem => item.ClassRoll)
                                </span>
                            </td>

                            <td class="p-1 text-nowrap">
                                @{
                                    name = textInfo.ToTitleCase(item.StudentName);
                                }
                                <a asp-action="Details" asp-route-id="@item.Id" asp-controller="Students">
                                    @if (item.Status)
                                    {
                                        <span>
                                            @name
                                            @if (item.IsResidential)
                                            {
                                                <span class="badge badge-info"><i class="fas fa-home"></i></span>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">
                                            @name
                                            @if (item.IsResidential)
                                            {
                                                <span class="badge badge-info"><i class="fas fa-home"></i></span>
                                            }
                                        </span>
                                    }
                                </a>
                            </td>
                            <td class="p-1 text-nowrap">
                                <span>
                                    @item.NameBangla
                                </span>
                            </td>
                            <td class="p-1 text-nowrap">
                                <span>
                                    @Html.DisplayFor(modelItem => item.ClassName)
                                </span>
                            </td>
                            @if (item.SectionName != null)
                            {
                                <td class="p-1 text-nowrap">
                                    <span>
                                        @item.SectionName
                                    </span>
                                </td>
                            }
                            else
                            {
                                <td class="p-1">
                                    <span>
                                        N/A
                                    </span>
                                </td>
                            }

                            <td class="p-1">
                                <span>
                                    @item.PhoneNo.ToString().PadLeft(11, '0')
                                </span>
                            </td>
                            <td class="p-1">
                                <span>
                                    @if (item.GuardianPhone != null)
                                    {
                                        @item.GuardianPhone.ToString().PadLeft(11, '0')
                                    }
                                </span>
                            </td>

                            <td class="p-1">
                                <span>
                                    @Html.DisplayFor(modelItem => item.SessionName)
                                </span>
                            </td>
                            <td class="p-1">
                                <span>
                                    @item.Gender
                                </span>
                            </td>
                            @if (item.Status)
                            {
                                <td class="p-1">
                                    <span>
                                        <input type="checkbox" checked disabled />
                                    </span>
                                </td>
                            }
                            else
                            {
                                <td class="p-1 no-wrap">
                                    <span>
                                        <input class="text-danger" type="checkbox" disabled />
                                    </span>
                                </td>

                            }
                            <td class="p-1">
                                <span>
                                    <partial name="_Edit_Details_Delete" model="@item.Id" />

                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="p-0">
                @{
                    var prevDisabled = !Model.HasPreviousPage ? "disabled btn-default" : "btn-success";
                    var nextDisabled = !Model.HasNextPage ? "disabled btn-default" : "btn-success";
                }
                <div class="row">
                    <div class="col-md-7 col-sm-12">
                        <a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)"
                            asp-route-academicClassId="@(ViewData["selectedAcademicClassId"])"
                            asp-route-academicSectionId="@(ViewData["selectedAcademicSectionId"])"
                            asp-route-academicSessionId="@(ViewData["selectedAcademicSessionId"])"
                            asp-route-aCategory="@(ViewData["categoryId"])" asp-route-aStatus="@(ViewData["statusId"])"
                            asp-route-pageSize="@ViewData["pageRowCount"]"
                            asp-route-searchString="@ViewData["searchString"]" class="btn @prevDisabled">Previous</a>

                        @for (int i = Model.PageIndex - 8; i < Model.PageIndex + 8; i++)
                        {
                            var btnOuterSuccess = Model.PageIndex == i ? "btn-secondary" : "btn-outline-secondary";
                            if (i > 0 && i < Model.TotalPages)
                            {
                                <a asp-action="Index" asp-route-pageNumber="@i"
                                    asp-route-academicClassId="@(ViewData["selectedAcademicClassId"])"
                                    asp-route-academicSectionId="@(ViewData["selectedAcademicSectionId"])"
                                    asp-route-academicSessionId="@(ViewData["selectedAcademicSessionId"])"
                                    asp-route-aCategory="@(ViewData["categoryId"])" asp-route-aStatus="@(ViewData["statusId"])"
                                    asp-route-pageSize="@ViewData["pageRowCount"]"
                                    asp-route-searchString="@ViewData["searchString"]" class="btn @btnOuterSuccess">@i</a>

                            }


                        }

                        <a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)"
                            asp-route-academicClassId="@(ViewData["selectedAcademicClassId"])"
                            asp-route-academicSectionId="@(ViewData["selectedAcademicSectionId"])"
                            asp-route-academicSessionId="@(ViewData["selectedAcademicSessionId"])"
                            asp-route-aCategory="@(ViewData["categoryId"])" asp-route-aStatus="@(ViewData["statusId"])"
                            asp-route-pageSize="@ViewData["pageRowCount"]"
                            asp-route-searchString="@ViewData["searchString"]" class="btn @nextDisabled">
                            Next
                        </a>
                        <span>(Showing @showingCount of @ViewBag.totalFound in @Model.TotalPages pages)</span>
                    </div>
                    <div class="col-md-5 col-sm-12 text-md-end">
                        <div class="row">
                            <label class="col-md-4 text-md-end col-form-label">Rows per page</label>
                            <div class="col-md-3">
                                <select class="form-control" id="pageSizeDDId" name="rowsCount"
                                    asp-items="ViewBag.rowsCount">
                                </select>
                            </div>
                            <button type="button" class="btn btn-warning col-md-4 text-dark" id="openExportBtn"
                                    title="Choose columns and format, then download the filtered list">
                                <i class="fa fa-file-excel"></i> Export
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

    </form>
</div>

<!-- Export column-picker modal -->
<div class="modal fade" id="exportModal" tabindex="-1" aria-labelledby="exportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-navy-blue text-light">
                <h5 class="modal-title" id="exportModalLabel"><i class="fa fa-file-excel"></i> Export Students</h5>
                <button type="button" class="close text-light" style="background:none;border:0;font-size:1.5rem;line-height:1;"
                        data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-2">
                    The export respects the filters currently applied to the list. Tick the columns you want, choose a
                    format, and download.
                </p>
                <div class="d-flex align-items-center mb-2">
                    <div class="btn-group btn-group-sm mr-3">
                        <button type="button" class="btn btn-outline-primary" id="exportSelectAll">Select all</button>
                        <button type="button" class="btn btn-outline-secondary" id="exportClear">Clear</button>
                    </div>
                    <div class="ml-auto">
                        <label class="mr-2 mb-0"><strong>Format:</strong></label>
                        <label class="mr-2 mb-0"><input type="radio" name="exportFormat" value="csv" checked> CSV</label>
                        <label class="mb-0"><input type="radio" name="exportFormat" value="xlsx"> Excel (.xlsx)</label>
                    </div>
                </div>
                <div class="row">
                    @foreach (var group in StudentExportColumns.Grouped())
                    {
                        <div class="col-md-4 col-sm-6 mb-3">
                            <div class="border rounded p-2 h-100">
                                <div class="fw-bold text-primary mb-1" style="font-weight:600;">@group.Key</div>
                                @foreach (var col in group)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input export-col" type="checkbox" value="@col.Key"
                                               id="exp_@col.Key" @(col.Default ? "checked" : "")>
                                        <label class="form-check-label" for="exp_@col.Key">@col.Header</label>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <span class="mr-auto text-muted small"><span id="exportSelectedCount">0</span> column(s) selected</span>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="doExportBtn"><i class="fa fa-download"></i> Download</button>
            </div>
        </div>
    </div>
</div>

<!-- Full-screen overlay (hidden by default) -->
<div id="loadingOverlay"
    style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); z-index: 9998;">
</div>

<!-- Loading spinner (hidden by default) -->
<div id="loadingSpinner" style="display: none; position: fixed; top: 50%; left: 50%; z-index: 1000;">
    <div class="spinner-border text-primary" role="status">
        <span class="sr-only">Loading...</span>
    </div>
</div>


@section Scripts {
    @* <script src="~/lib/jquery/dist/jquery.min.js"></script> *@
    <script src="~/js/AlertifyNotify/AlertifyNofify.js"></script>

    <script>
        history.replaceState && history.replaceState(null, '', window.location.href);

        let saved = '@TempData["saved"]';
        let deleted = '@TempData["deleted"]';
        let edited = '@TempData["edited"]';
        let failed = '@TempData["failed"]'
        if (saved != "") {
            alertify.success("Saved Successfully");
        }
        if (deleted != "") {
            alertify.error("Deleted Successfully");
        }
        if (edited != "") {
            alertify.message('Updated Successfully');
        }
        if (failed != "") {
            alertify.error(failed);
        }


        function submitFilterForm() {
            var form = document.getElementById('FilterForm');
            var url = form.getAttribute('action') + '?' + new URLSearchParams(new FormData(form)).toString();
            document.getElementById('loadingOverlay').style.display = 'block';
            document.getElementById('loadingSpinner').style.display = 'block';
            window.location.href = url;
        }

        $(document).ready(function () {
            $("#myTable_info").detach().insertAfter('#myTable_length');

            $('#findButton').on('click', function () {
                submitFilterForm();
            });

            $('#FilterForm').on('submit', function (e) {
                e.preventDefault();
                submitFilterForm();
            });

            $('#aAcademicClassId').change(function () {
                let id = $('#aAcademicClassId option:selected').val();
                let sessionId = $('#aAcademicSessionId option:selected').val();

                $.ajax({
                    url: "/api/academicsections/getbyclasswithsessionId?classId=" + id + "&sessionId=" + sessionId,
                    dataType: "JSON",
                    type: "POST",
                    cache: false,
                    success: function (data) {
                        $('#aAcademicSectionId').empty();

                        if (data != null || data != '') {
                            var o = '<option disabled selected>Select Section Name</option>';
                            var o2 = '<option value="0">No Section</option>';
                            $('#aAcademicSectionId').append(o);
                            $('#aAcademicSectionId').append(o2);
                            $.each(data, function (i, obj) {
                                console.log(obj.name);
                                var op = '<option value="' + obj.id + '">' + obj.name + '</option>';
                                $('#aAcademicSectionId').append(op);
                            });
                        }
                        else {
                            var o = '<option disabled selected>Section Not Found</option>';
                            $('#aAcademicSectionId').append(o);
                        }
                    },
                    error: function (err) {
                        console.log(err);
                    }
                });
            });
            $('#aAcademicSessionId').change(function () {
                $('#aAcademicSectionId').empty();
                $.ajax({
                    url: "/academicClasses/getAll",
                    dataType: "JSON",
                    type: "POST",
                    cache: false,
                    success: function (data) {
                        $('#aAcademicClassId').empty();
                        var o = '<option disabled selected>Select Class Name</option>';
                        $('#aAcademicClassId').append(o);
                        $.each(data, function (i, obj) {
                            console.log(obj.name);
                            var op = '<option value="' + obj.id + '">' + obj.name + '</option>';
                            $('#aAcademicClassId').append(op);
                        });
                    },
                    error: function (err) {
                        console.log(err);
                    }
                });
            });

            //pageSize Dropdown change code
            $('#pageSizeDDId').change(function () {
                let pageSizeDDId = $('#pageSizeDDId').val();
                $("#pageSizeHiddenId").val(pageSizeDDId);
                submitFilterForm();
            })
        });
        //Searching filter
        //searchParameter
        let classVal = '', catVal = '', secVal = '', statusVal = '', searchVal = '';

        const classData = $('#aAcademicClassId option:selected').val();
        const catData = $('#aCategoryId option:selected').val();
        const secData = $('#aAcademicSectionId option:selected').val();
        const statusData = $('#aStatusType option:selected').val();
        const searchKeyData = $('#nameRoll').val();
        if (classData !== "") {
            classVal = $('#aAcademicClassId option:selected').text();
        }
        if (catData !== '') {
            catVal = $('#aCategoryId option:selected').text();
        }
        if (secData !== '') {
            secVal = $('#aAcademicSectionId option:selected').text();
        }
        if (statusData !== "") {
            statusVal = $('#aStatusType option:selected').text();
        }
        if (searchKeyData !== "") {
            searchVal = $('#nameRoll').val();
        }


        $('#searchParameter').html(classVal + ' ' + secVal + ' ' + catVal + ' ' + statusVal + ' ' + searchVal);

        if (classVal == '' && secVal == '' && catVal == '' && statusVal == '' && searchVal == '') {
            $('#searchParameter').html('nothing');
        }

        // Show loading spinner when pagination links are clicked
        document.querySelectorAll('.pagination a, a.btn-success, a.btn-outline-secondary, a.btn-default').forEach(function (element) {
            element.addEventListener('click', function () {
                document.getElementById('loadingOverlay').style.display = 'block';
                document.getElementById('loadingSpinner').style.display = 'block';
            });
        });

        // Hide loading spinner after page load (handles both fresh load and Back/forward cache)
        window.addEventListener('pageshow', function () {
            document.getElementById('loadingOverlay').style.display = 'none';
            document.getElementById('loadingSpinner').style.display = 'none';
        });

        // ---------------------------------------------------------------------------
        // Export column-picker. Works under Bootstrap 5 (admin layout) and Bootstrap 4
        // (teacher layout) by feature-detecting the modal API.
        // ---------------------------------------------------------------------------
        (function () {
            var exportUrl = '@Url.Action("Export", "Students")';

            function showModal(id) {
                var el = document.getElementById(id);
                if (window.bootstrap && bootstrap.Modal) { bootstrap.Modal.getOrCreateInstance(el).show(); }
                else { $(el).modal('show'); }
            }
            function hideModal(id) {
                var el = document.getElementById(id);
                if (window.bootstrap && bootstrap.Modal) { bootstrap.Modal.getOrCreateInstance(el).hide(); }
                else { $(el).modal('hide'); }
            }

            function refreshCount() {
                $('#exportSelectedCount').text($('.export-col:checked').length);
            }

            $('#openExportBtn').on('click', function () { refreshCount(); showModal('exportModal'); });
            $('#exportSelectAll').on('click', function () { $('.export-col').prop('checked', true); refreshCount(); });
            $('#exportClear').on('click', function () { $('.export-col').prop('checked', false); refreshCount(); });
            $('.export-col').on('change', refreshCount);
            // BS4 teacher layout lacks .btn-close styling; make the cancel/close dismiss work via JS too.
            $('#exportModal [data-dismiss="modal"], #exportModal [data-bs-dismiss="modal"]').on('click', function () { hideModal('exportModal'); });

            $('#doExportBtn').on('click', function () {
                var cols = $('.export-col:checked').map(function () { return this.value; }).get();
                if (cols.length === 0) {
                    if (window.alertify) { alertify.error('Please select at least one column.'); }
                    else { alert('Please select at least one column.'); }
                    return;
                }

                var p = new URLSearchParams();
                // Carry the list's current filters so the export matches what's on screen.
                var map = {
                    academicSessionId: $('#aAcademicSessionId').val(),
                    academicClassId: $('#aAcademicClassId').val(),
                    academicSectionId: $('#aAcademicSectionId').val(),
                    aCategory: $('#aCategoryId').val(),
                    aStatus: $('#aStatusType').val(),
                    searchString: $('#nameRoll').val()
                };
                Object.keys(map).forEach(function (k) { if (map[k]) p.set(k, map[k]); });
                p.set('format', $('input[name="exportFormat"]:checked').val() || 'csv');
                cols.forEach(function (c) { p.append('columns', c); });

                hideModal('exportModal');
                window.location.href = exportUrl + '?' + p.toString();
            });
        })();

    </script>

}