@model GuardianResetPasswordVM
@{
    ViewData["Title"] = "Set a new password";
}
<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <h1 class="h3">Set a new password</h1>
        <p class="text-muted small">Enter the code sent to <strong>@ViewBag.MaskedMobile</strong> and choose a new password.</p>
        <div class="card adm-card"><div class="card-body">
            <form asp-action="ResetPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                <input type="hidden" asp-for="MobileNumber" />
                <div class="mb-3">
                    <label asp-for="Code" class="form-label"></label>
                    <input asp-for="Code" class="form-control text-center" inputmode="numeric" autocomplete="one-time-code" maxlength="6" />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Change password</button>
            </form>
            <div class="text-center mt-2 small"><a asp-action="ForgotPassword">Send a new code</a></div>
        </div></div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
