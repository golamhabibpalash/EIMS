@model ApplicationFormVM
<div class="d-flex flex-wrap gap-2 justify-content-between mt-3">
    <div>
        @if (Model.Step > 1)
        {
            <button type="submit" name="command" value="back" class="btn btn-outline-secondary" formnovalidate><i class="fa fa-arrow-left"></i> Back</button>
        }
    </div>
    <div class="d-flex gap-2">
        <button type="submit" name="command" value="draft" class="btn btn-outline-primary" formnovalidate><i class="fa fa-save"></i> Save draft</button>
        <button type="submit" name="command" value="next" class="btn btn-primary">Save &amp; continue <i class="fa fa-arrow-right"></i></button>
    </div>
</div>
