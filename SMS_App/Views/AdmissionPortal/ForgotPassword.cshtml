@model GuardianForgotPasswordVM
@{
    ViewData["Title"] = "Forgot password";
}
<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <h1 class="h3">Forgot password</h1>
        <p class="text-muted small">Enter the mobile number you registered with. We'll text you a code to set a new password.</p>
        <div class="card adm-card"><div class="card-body">
            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="MobileNumber" class="form-label"></label>
                    <input asp-for="MobileNumber" class="form-control" inputmode="tel" placeholder="01XXXXXXXXX" />
                    <span asp-validation-for="MobileNumber" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Send code</button>
            </form>
        </div></div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
