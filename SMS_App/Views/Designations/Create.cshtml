@model SMS.Entities.Designation

@{
    ViewData["Title"] = "Create Designation";
    GlobalUI.PageTitle = "Add New Designation";
}

<div class="row">
    <div class="col-md-8 offset-2">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group row">
                <label asp-for="DesignationName" class="control-label col-form-label col-md-2 text-right"></label>
                <div class="col-md-10">
                    <input asp-for="DesignationName" class="form-control " />
                    <span asp-validation-for="DesignationName" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="DesignationTypeId" class="control-label col-form-label col-md-2 text-right"></label>
                <div class="input-group col-md-10">
                    <select asp-for="DesignationTypeId" asp-items="@ViewBag.DesignationTypeList" class="form-control ">
                        <option selected disabled>Select Designation Category</option>
                    </select>
                    <a asp-action="Create" asp-controller="DesignationTypes" class="btn btn-outline-info btn-sm"><i class="fa fa-plus"></i> Add</a>
                    <span asp-validation-for="DesignationTypeId" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="EmpTypeId" class="control-label col-form-label col-md-2 text-right"></label>
                <div class="input-group col-md-10">
                    <select asp-for="EmpTypeId" asp-items="@ViewBag.EmpTypeList" class="form-control ">
                        <option selected disabled>Select Employee Type</option>
                    </select>
                    <a asp-action="Create" asp-controller="EmpTypes" class="btn btn-outline-info btn-sm"><i class="fa fa-plus"></i> Add</a>
                    <span asp-validation-for="EmpTypeId" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="SortingOrder" class="control-label col-form-label col-md-2 text-right"></label>
                <div class="input-group col-md-10">
                    <input asp-for="SortingOrder" class="form-control " />
                    <span asp-validation-for="SortingOrder" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row offset-2">
                <div class="col-md-12 text-center">
                    <partial name="_Create_Back" />
                </div>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
