@model AdmissionSetting
@{
    ViewData["Title"] = "Admission Portal Settings";
    GlobalUI.PageTitle = "Admission Portal Settings";
}
<partial name="_AdmissionStaffAlerts" />
<form asp-action="Settings" method="post" style="max-width:900px">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
    <div class="card shadow-sm mb-3"><div class="card-body">
        <h5>Helpline &amp; WhatsApp</h5>
        <p class="small text-muted">Shown on the notice, landing page, user manual and application screens. Leave a field empty to hide it - nothing is shown in its place.</p>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="HelplinePhone" class="form-label"></label>
                <input asp-for="HelplinePhone" class="form-control" placeholder="e.g. 01712345678" />
            </div>
            <div class="col-md-4">
                <label asp-for="WhatsAppNumber" class="form-label"></label>
                <input asp-for="WhatsAppNumber" class="form-control" placeholder="01XXXXXXXXX" />
                <div class="form-text">Opens a WhatsApp chat (wa.me link).</div>
            </div>
            <div class="col-md-4">
                <label asp-for="SupportHours" class="form-label"></label>
                <input asp-for="SupportHours" class="form-control" placeholder="Sun-Thu, 9 am - 4 pm" />
            </div>
            <div class="col-12">
                <label asp-for="SupportMessage" class="form-label"></label>
                <input asp-for="SupportMessage" class="form-control" placeholder="e.g. For privacy, staff will confirm your application number and mobile before discussing it." />
            </div>
        </div>
    </div></div>
    <div class="card shadow-sm mb-3"><div class="card-body">
        <h5>Applications</h5>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="ApplicationNoPrefix" class="form-label"></label>
                <input asp-for="ApplicationNoPrefix" class="form-control text-uppercase" maxlength="10" />
                <div class="form-text">Numbers look like @(Model.ApplicationNoPrefix ?? "ADM")-2027-00001.</div>
            </div>
            <div class="col-md-4">
                <label asp-for="MaxUploadSizeKb" class="form-label"></label>
                <input asp-for="MaxUploadSizeKb" type="number" min="100" max="10240" class="form-control" />
                <div class="form-text">Upper limit for any single upload.</div>
            </div>
            <div class="col-md-4 pt-md-4">
                <div class="form-check"><input asp-for="RequireOtpVerification" class="form-check-input" /><label asp-for="RequireOtpVerification" class="form-check-label"></label></div>
                <div class="form-check"><input asp-for="SendSmsNotifications" class="form-check-input" /><label asp-for="SendSmsNotifications" class="form-check-label"></label></div>
                <div class="form-text">SMS uses the school's existing SMS gateway and respects the global SMS switch.</div>
            </div>
            <div class="col-12">
                <label asp-for="UserManualNotes" class="form-label"></label>
                <textarea asp-for="UserManualNotes" rows="4" class="form-control" placeholder="Anything specific to your school that first-time applicants should know."></textarea>
            </div>
        </div>
    </div></div>
    <button type="submit" class="btn btn-primary">Save settings</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</form>
