@model IEnumerable<MobileNotice>
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    var canCreate = (await AuthorizationService.AuthorizeAsync(User, "CreateMobileNoticesPolicy")).Succeeded;
    var canEdit = (await AuthorizationService.AuthorizeAsync(User, "EditMobileNoticesPolicy")).Succeeded;
    var canDelete = (await AuthorizationService.AuthorizeAsync(User, "DeleteMobileNoticesPolicy")).Succeeded;
}

@{
    ViewData["Title"] = "Student Notices";
    GlobalUI.PageTitle = ViewData["Title"].ToString();
    var items = Model.OrderBy(n => n.DisplayOrder).ThenByDescending(n => n.CreatedAt).ToList();
}

@if (TempData["created"] != null)
{
    <div class="alert alert-success">@TempData["created"]</div>
}
@if (TempData["deleted"] != null)
{
    <div class="alert alert-info">@TempData["deleted"]</div>
}
@if (TempData["failed"] != null)
{
    <div class="alert alert-danger">@TempData["failed"]</div>
}

<div class="row">
    <div class="col-12 mb-2">
        @if (canCreate)
        {
            <a asp-action="CreateNotice" class="btn btn-info btn-sm">Add Notice</a>
        }
    </div>
    <table class="table table-bordered table-striped table-responsive-sm" id="myTable">
        <thead>
            <tr>
                <th>#</th>
                <th>Title</th>
                <th>Order</th>
                <th>Published</th>
                <th>From</th>
                <th>To</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < items.Count; i++)
            {
                var item = items[i];
                <tr>
                    <td>@(i + 1)</td>
                    <td>@item.Title</td>
                    <td>@item.DisplayOrder</td>
                    <td>@(item.IsPublished ? "Yes" : "No")</td>
                    <td>@item.PublishedFrom?.ToString("dd MMM yyyy")</td>
                    <td>@item.PublishedTo?.ToString("dd MMM yyyy")</td>
                    <td>
                        @if (canEdit)
                        {
                            <a asp-action="EditNotice" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Edit</a>
                        }
                        @if (canDelete)
                        {
                            <form asp-action="DeleteNotice" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this notice?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (items.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">No notices have been added.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
