@using SMS.Entities.Enums
@model IEnumerable<SMS.Entities.TransferCertificate>
@{
    var studentId = (int)ViewBag.StudentId;
    var canManage = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");

    string Badge(TransferCertificateStatus s) => s switch
    {
        TransferCertificateStatus.Issued => "<span class='badge bg-success'>Issued</span>",
        TransferCertificateStatus.Cancelled => "<span class='badge bg-danger'>Cancelled</span>",
        _ => "<span class='badge bg-warning text-dark'>Draft</span>"
    };
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h6 class="mb-0">Transfer Certificates</h6>
    @if (canManage)
    {
        <a asp-controller="TransferCertificates" asp-action="Create" asp-route-studentId="@studentId" class="btn btn-sm btn-primary" target="_blank">
            <i class="fa fa-plus"></i> New
        </a>
    }
</div>

@if (!Model.Any())
{
    <p class="text-muted small">No transfer certificates for this student.</p>
}
else
{
    <table class="table table-sm table-bordered">
        <thead class="table-light">
            <tr><th>Certificate No</th><th>Issue Date</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.CertificateNo</td>
                    <td>@t.IssueDate.ToString("dd MMM yyyy")</td>
                    <td>@Html.Raw(Badge(t.Status))</td>
                    <td><a asp-controller="TransferCertificates" asp-action="Details" asp-route-id="@t.Id" target="_blank" class="btn btn-sm btn-outline-info"><i class="fa fa-eye"></i></a></td>
                </tr>
            }
        </tbody>
    </table>
}
