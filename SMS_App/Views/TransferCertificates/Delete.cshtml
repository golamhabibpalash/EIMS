@model SMS.Entities.TransferCertificate
@{
    ViewData["Title"] = "Delete Transfer Certificate";
    GlobalUI.PageTitle = "Delete Transfer Certificate";
}

<div class="card shadow-sm">
    <div class="card-header bg-danger text-light"><h5 class="mb-0"><i class="fa fa-trash mr-2"></i> Delete Draft Certificate</h5></div>
    <div class="card-body">
        <p class="text-danger">Are you sure you want to permanently delete this <strong>draft</strong> certificate? Issued certificates cannot be deleted (cancel them instead).</p>
        <dl class="row">
            <dt class="col-sm-3">Certificate No</dt><dd class="col-sm-9">@Model.CertificateNo</dd>
            <dt class="col-sm-3">Student</dt><dd class="col-sm-9">@Model.StudentNameSnapshot (@Model.UniqueIdSnapshot)</dd>
            <dt class="col-sm-3">Class</dt><dd class="col-sm-9">@Model.ClassNameSnapshot</dd>
        </dl>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger"><i class="fa fa-trash"></i> Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
