@{
    var studentId = (int)ViewBag.StudentId;
}
<h6 class="mb-2">Generate Transfer Certificate</h6>
<form method="get" asp-controller="TransferCertificates" asp-action="Generate" target="_blank" class="row g-2 align-items-end">
    <input type="hidden" name="studentId" value="@studentId" />
    <div class="col-md-3 col-6">
        <label class="form-label mb-0 small text-muted">Issue Date</label>
        <input type="date" name="issueDate" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-4 col-6">
        <label class="form-label mb-0 small text-muted">Signatory Name</label>
        <input type="text" name="signatoryName" class="form-control form-control-sm" placeholder="e.g. A N M Arif Badal" />
    </div>
    <div class="col-md-3 col-6">
        <label class="form-label mb-0 small text-muted">Designation</label>
        <input type="text" name="signatoryDesignation" class="form-control form-control-sm" value="Headmaster" />
    </div>
    <div class="col-12"><small class="text-muted">Optional last-exam line:</small></div>
    <div class="col-md-3 col-6"><label class="form-label mb-0 small text-muted">Exam Name</label><input type="text" name="examName" class="form-control form-control-sm" placeholder="e.g. Monthly Exam" /></div>
    <div class="col-md-2 col-6"><label class="form-label mb-0 small text-muted">Total Marks</label><input type="text" name="totalMarks" class="form-control form-control-sm" /></div>
    <div class="col-md-2 col-6"><label class="form-label mb-0 small text-muted">GPA</label><input type="text" name="gpa" class="form-control form-control-sm" /></div>
    <div class="col-md-2 col-6"><label class="form-label mb-0 small text-muted">Grade</label><input type="text" name="grade" class="form-control form-control-sm" /></div>
    <div class="col-md-3 col-6"><label class="form-label mb-0 small text-muted">Merit Rank</label><input type="text" name="meritRank" class="form-control form-control-sm" /></div>
    <div class="col-md-3 col-12">
        <button type="submit" class="btn btn-primary btn-sm w-100"><i class="fa fa-file-pdf"></i> Generate</button>
    </div>
</form>
