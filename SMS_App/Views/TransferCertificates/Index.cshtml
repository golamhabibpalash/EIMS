@using SMS_App.ViewModels.Certificates
@model CertificateFilterVM
@{
    ViewData["Title"] = "Transfer Certificate";
    GlobalUI.PageTitle = "Transfer Certificate";
}

<div class="card shadow-sm mb-3">
    <div class="card-header"><h5 class="mb-0"><i class="fa fa-file-signature mr-2"></i> Student Transfer Certificate</h5></div>
    <div class="card-body py-2">
        <form method="get" asp-action="Index" id="filterForm">
            <div class="row g-2 align-items-end">
                <div class="col-xl-2 col-lg-3 col-md-4 col-6 mb-2">
                    <label class="form-label mb-0 small text-muted">Session</label>
                    <select class="form-control form-control-sm" name="academicSessionId" id="fSession" asp-items="@ViewBag.academicSessionId"></select>
                </div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-6 mb-2">
                    <label class="form-label mb-0 small text-muted">Class</label>
                    <select class="form-control form-control-sm" name="academicClassId" id="fClass" asp-items="@ViewBag.academicClassId"><option value="">Select class</option></select>
                </div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-6 mb-2">
                    <label class="form-label mb-0 small text-muted">Section</label>
                    <select class="form-control form-control-sm" name="academicSectionId" id="fSection" asp-items="@(ViewBag.SectionList as Microsoft.AspNetCore.Mvc.Rendering.SelectList)"><option value="">All sections</option></select>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 col-12 mb-2">
                    <label class="form-label mb-0 small text-muted">Keyword</label>
                    <input type="text" class="form-control form-control-sm" name="searchString" placeholder="Name / Roll / ID / Phone" value="@Model.SearchString">
                </div>
                <div class="col-12 col-lg-auto mb-2">
                    <button type="submit" class="btn btn-primary btn-sm"><i class="fa fa-search"></i> Find Students</button>
                </div>
            </div>
        </form>
        <hr class="my-2" />
        <div class="row g-2 align-items-end">
            <div class="col-md-2 col-6 mb-2">
                <label class="form-label mb-0 small text-muted">Issue Date</label>
                <input type="date" class="form-control form-control-sm" id="optIssueDate" value="@DateTime.Today.ToString("yyyy-MM-dd")">
            </div>
            <div class="col-md-3 col-6 mb-2">
                <label class="form-label mb-0 small text-muted">Signatory Name</label>
                <input type="text" class="form-control form-control-sm" id="optSigName" placeholder="e.g. A N M Arif Badal">
            </div>
            <div class="col-md-2 col-6 mb-2">
                <label class="form-label mb-0 small text-muted">Designation</label>
                <input type="text" class="form-control form-control-sm" id="optSigDesig" value="@Model.SignatoryDesignation">
            </div>
        </div>
        <div class="row g-2 align-items-end">
            <div class="col-12"><small class="text-muted"><i class="fa fa-info-circle"></i> Optional last-exam line (leave blank to omit):</small></div>
            <div class="col-md-3 col-6 mb-2"><label class="form-label mb-0 small text-muted">Exam Name</label><input type="text" class="form-control form-control-sm" id="optExamName" placeholder="e.g. Monthly Exam"></div>
            <div class="col-md-2 col-6 mb-2"><label class="form-label mb-0 small text-muted">Total Marks</label><input type="text" class="form-control form-control-sm" id="optMarks"></div>
            <div class="col-md-2 col-6 mb-2"><label class="form-label mb-0 small text-muted">GPA</label><input type="text" class="form-control form-control-sm" id="optGpa"></div>
            <div class="col-md-2 col-6 mb-2"><label class="form-label mb-0 small text-muted">Grade</label><input type="text" class="form-control form-control-sm" id="optGrade"></div>
            <div class="col-md-2 col-6 mb-2"><label class="form-label mb-0 small text-muted">Merit Rank</label><input type="text" class="form-control form-control-sm" id="optRank"></div>
        </div>
    </div>
</div>

@if (!Model.HasQueried)
{
    <div class="alert alert-info"><i class="fa fa-info-circle"></i> Choose a class (and optionally a section) or type a keyword, then <strong>Find Students</strong>.</div>
}
else if (Model.Students.Count == 0)
{
    <div class="alert alert-warning"><i class="fa fa-exclamation-triangle"></i> No students match the filter.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle w-100" id="studentsTable">
                    <thead class="table-dark"><tr><th>#</th><th>Student ID</th><th>Roll</th><th>Name</th><th>Class</th><th>Section</th><th class="text-nowrap">Certificate</th></tr></thead>
                    <tbody>
                        @{ var sl = 1; }
                        @foreach (var s in Model.Students)
                        {
                            <tr>
                                <td>@(sl++)</td>
                                <td>@s.UniqueId</td>
                                <td>@s.ClassRoll</td>
                                <td>@s.Name</td>
                                <td>@s.ClassName</td>
                                <td>@(s.SectionName ?? "-")</td>
                                <td class="text-nowrap">
                                    <button class="btn btn-sm btn-primary gen-view" data-id="@s.Id"><i class="fa fa-eye"></i> View</button>
                                    <button class="btn btn-sm btn-outline-danger gen-dl" data-id="@s.Id"><i class="fa fa-download"></i> PDF</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            const base = '@Url.Action("Generate", "TransferCertificates")';
            function val(id) { const e = document.getElementById(id); return e ? e.value : ''; }
            function url(id, dl) {
                const p = new URLSearchParams();
                p.set('studentId', id);
                if (val('optIssueDate')) p.set('issueDate', val('optIssueDate'));
                if (val('optSigName')) p.set('signatoryName', val('optSigName'));
                if (val('optSigDesig')) p.set('signatoryDesignation', val('optSigDesig'));
                if (val('optExamName')) p.set('examName', val('optExamName'));
                if (val('optMarks')) p.set('totalMarks', val('optMarks'));
                if (val('optGpa')) p.set('gpa', val('optGpa'));
                if (val('optGrade')) p.set('grade', val('optGrade'));
                if (val('optRank')) p.set('meritRank', val('optRank'));
                if (dl) p.set('download', 'true');
                return base + '?' + p.toString();
            }
            document.querySelectorAll('.gen-view').forEach(b => b.addEventListener('click', () => window.open(url(b.dataset.id, false), '_blank')));
            document.querySelectorAll('.gen-dl').forEach(b => b.addEventListener('click', () => window.open(url(b.dataset.id, true), '_blank')));
            if ($.fn.DataTable) $('#studentsTable').DataTable({ order: [], pageLength: 25 });

            const $class = $('#fClass'), $session = $('#fSession'), $section = $('#fSection');
            function reloadSections() {
                const classId = $class.val(), sessionId = $session.val();
                $section.empty().append('<option value="">All sections</option>');
                if (!classId) return;
                $.ajax({ url: "/api/academicsections/getbyclasswithsessionId?classId=" + classId + "&sessionId=" + sessionId, dataType: "JSON", type: "POST", cache: false,
                    success: function (data) { $.each(data || [], function (i, o) { $section.append('<option value="' + o.id + '">' + o.name + '</option>'); }); } });
            }
            $class.on('change', reloadSections); $session.on('change', reloadSections);
        })();
    </script>
}
