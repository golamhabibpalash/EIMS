@using SMS.BLL.Managers;
@using SMS.Entities;
@using SMS_App.ViewModels.PaymentVM;
@model DuePaymentVM
@{
    ViewData["Title"] = "Due Payment";
    bool isFromPost = ViewBag.isFromPost ?? false;
    bool hasRows = Model.DuePayments.Count > 0;
    var today = DateTime.Today;
    string Iso(DateTime? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? "";

    var results = new DueListResultsVM
    {
        Rows = Model.DuePayments,
        Institute = Model.Institute,
        ReportTitle = "Due Payments (session)",
        ScopeLines = Model.DescribeFilters(),
        IsFromPost = isFromPost,
        DueOnly = Model.DueOnly,
        EmptyHint = "Leave the dates empty for the whole session, or pick a fee period such as \"Up to this month\"."
    };
}
@section Styles {
    <link rel="stylesheet" href="~/css/due-list.css" asp-append-version="true" />
    <style>
        .period-presets .btn { white-space: nowrap; font-size: .8rem; }
    </style>
}

<div class="card shadow-sm mb-3 no-print">
    <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h5 class="mb-0"><i class="fa fa-money-bill-wave me-2"></i> Due Payment</h5>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="printBtn" @(hasRows ? "" : "disabled")
                    title="Print the list as shown">
                <i class="fa fa-print"></i> Print
            </button>
            <div class="btn-group btn-group-sm">
                <button type="button" class="btn btn-success dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"
                        id="exportBtn" @(hasRows ? "" : "disabled")
                        title="@(hasRows ? "Download the list in its current order and search" : "Load a list first")">
                    <i class="fa fa-download"></i> Export
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="exportBtn">
                    <li><a class="dropdown-item export-link" href="#" data-format="xlsx"><i class="fa fa-file-excel text-success me-2"></i> Excel (.xlsx)</a></li>
                    <li><a class="dropdown-item export-link" href="#" data-format="csv"><i class="fa fa-file-csv text-primary me-2"></i> CSV</a></li>
                    <li><a class="dropdown-item export-link" href="#" data-format="pdf"><i class="fa fa-file-pdf text-danger me-2"></i> PDF</a></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="card-body py-3">
        <form id="dueForm" asp-action="DuePayment" method="post" novalidate>
            <div class="row g-2 align-items-end">
                <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
                    <label for="AcademicSessionId" class="form-label mb-1 small text-muted">Session</label>
                    <select class="form-select form-select-sm" asp-for="AcademicSessionId">
                        @foreach (var s in Model.AcademicSessionList)
                        {
                            <option value="@s.Value" selected="@s.Selected"
                                    data-year="@DuePeriodRules.SessionYear(new AcademicSession { Name = s.Text }, today)">@s.Text</option>
                        }
                    </select>
                </div>
                <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
                    <label for="AcademicClassId" class="form-label mb-1 small text-muted">Class</label>
                    <select class="form-select form-select-sm" asp-for="AcademicClassId" asp-items="Model.AcademicClassList">
                        <option value="0">All classes</option>
                    </select>
                </div>
                <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
                    <label for="AcademicSectionId" class="form-label mb-1 small text-muted">Section</label>
                    <select class="form-select form-select-sm" asp-for="AcademicSectionId" asp-items="Model.AcademicSectionList"
                            disabled="@(Model.AcademicClassId > 0 ? null : "disabled")">
                        <option value="0">All sections</option>
                    </select>
                </div>
                <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
                    <label for="Category" class="form-label mb-1 small text-muted">Category</label>
                    <select class="form-select form-select-sm" asp-for="Category">
                        <option value="all">All</option>
                        <option value="residential">Residential</option>
                        <option value="nonResidential">Non-residential</option>
                    </select>
                </div>
                <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
                    <label for="Status" class="form-label mb-1 small text-muted">Student status</label>
                    <select class="form-select form-select-sm" asp-for="Status">
                        <option value="2">All</option>
                        <option value="1">Active</option>
                        <option value="0">Inactive</option>
                    </select>
                </div>
            </div>

            <fieldset class="row g-2 align-items-end mt-1">
                <legend class="visually-hidden">Fee period</legend>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                    <label for="FromDate" class="form-label mb-1 small text-muted">Fee period from</label>
                    <input type="date" class="form-control form-control-sm" id="FromDate" name="FromDate" value="@Iso(Model.FromDate)"
                           min="@Model.SessionYear-01-01" max="@Model.SessionYear-12-31" />
                </div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                    <label for="ToDate" class="form-label mb-1 small text-muted">to</label>
                    <input type="date" class="form-control form-control-sm" id="ToDate" name="ToDate" value="@Iso(Model.ToDate)"
                           min="@Model.SessionYear-01-01" max="@Model.SessionYear-12-31" aria-describedby="periodHelp" />
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" role="switch" asp-for="DueOnly">
                        <label class="form-check-label small" for="DueOnly">Only students with a due</label>
                    </div>
                </div>
                <div class="col-xl-2 col-lg-3 col-md-6 col-sm-6 text-end">
                    <button type="submit" id="loadBtn" class="btn btn-primary btn-sm w-100">
                        <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                        <span class="btn-label"><i class="fa fa-search"></i> Get list</span>
                    </button>
                </div>
                <div class="col-12">
                    <span asp-validation-for="ToDate" class="text-danger small d-block"></span>
                    <div class="d-flex flex-wrap align-items-center gap-1 period-presets" role="group" aria-label="Quick fee periods">
                        <span class="small text-muted me-1">Quick period:</span>
                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" data-preset="month">This month</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" data-preset="upto">Up to this month</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" data-preset="last3">Last 3 months</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" data-preset="all">Whole session</button>
                    </div>
                    <div id="periodHelp" class="form-text mt-1">
                        Fees are charged by month: any month the period touches is included, with only the payments made
                        against those fees. Leave both dates empty for the whole session.
                    </div>
                </div>
            </fieldset>
        </form>
    </div>
</div>

<partial name="_DueListResults" model="results" />

@section Scripts {
    <script src="~/js/due-list.js" asp-append-version="true"></script>
    <script>
        (function () {
            const sectionsUrl = '/api/academicsections/getbyclasswithsessionId';
            const exportUrl = '@Url.Action("DuePaymentExport", "StudentPayments")';

            // Filters the CURRENT list was loaded with (not the live form, which the user may have
            // changed without reloading), so an export always matches the rows on screen.
            const applied = {
                academicSessionId: '@Model.AcademicSessionId',
                academicClassId: '@Model.AcademicClassId',
                academicSectionId: '@Model.AcademicSectionId',
                category: '@Model.Category',
                status: '@Model.Status',
                fromDate: '@Iso(Model.FromDate)',
                toDate: '@Iso(Model.ToDate)',
                dueOnly: '@Model.DueOnly.ToString().ToLowerInvariant()'
            };

            const $session = $('#AcademicSessionId'), $class = $('#AcademicClassId'), $section = $('#AcademicSectionId');
            const $from = $('#FromDate'), $to = $('#ToDate');

            function resetSelect($el, allText, disabled) {
                $el.empty().append($('<option>').val('0').text(allText)).prop('disabled', disabled);
            }

            function loadSections() {
                const classId = $class.val();
                resetSelect($section, 'All sections', true);
                if (!classId || classId === '0') return;
                $section.find('option').first().text('Loading…');
                const p = new URLSearchParams({ classId: classId, sessionId: $session.val() || '0' });
                $.ajax({ url: sectionsUrl + '?' + p.toString(), type: 'POST', dataType: 'json', cache: false })
                    .done(function (data) {
                        resetSelect($section, 'All sections', false);
                        $.each(data || [], function (_, s) { $section.append($('<option>').val(s.id).text(s.name)); });
                    })
                    .fail(function () { resetSelect($section, 'Could not load sections', false); });
            }

            // ----- Fee period -------------------------------------------------------------
            const pad = function (n) { return String(n).padStart(2, '0'); };
            const iso = function (y, m, d) { return y + '-' + pad(m) + '-' + pad(d); };
            const lastDay = function (y, m) { return new Date(y, m, 0).getDate(); }; // m is 1-12
            const sessionYear = function () { return parseInt($session.find('option:selected').data('year'), 10) || new Date().getFullYear(); };

            function applySessionBounds() {
                const y = sessionYear();
                const min = iso(y, 1, 1), max = iso(y, 12, 31);
                $from.add($to).attr({ min: min, max: max }).each(function () {
                    if (this.value && (this.value < min || this.value > max)) this.value = '';
                });
                // "This month" style presets only make sense for the session that contains today.
                const isCurrentYear = y === new Date().getFullYear();
                $('[data-preset="month"], [data-preset="upto"], [data-preset="last3"]')
                    .prop('disabled', !isCurrentYear)
                    .attr('title', isCurrentYear ? '' : 'Available for the session that includes today');
                markPreset();
            }

            function presetRange(preset) {
                const y = sessionYear(), now = new Date(), m = now.getMonth() + 1;
                switch (preset) {
                    case 'month': return [iso(y, m, 1), iso(y, m, lastDay(y, m))];
                    case 'upto': return [iso(y, 1, 1), iso(y, m, lastDay(y, m))];
                    case 'last3': { const s = Math.max(1, m - 2); return [iso(y, s, 1), iso(y, m, lastDay(y, m))]; }
                    default: return ['', ''];
                }
            }

            function markPreset() {
                $('[data-preset]').each(function () {
                    const r = presetRange($(this).data('preset'));
                    const on = !this.disabled && $from.val() === r[0] && $to.val() === r[1];
                    $(this).toggleClass('active', on).attr('aria-pressed', on);
                });
            }

            $('[data-preset]').on('click', function () {
                const r = presetRange($(this).data('preset'));
                $from.val(r[0]); $to.val(r[1]);
                markPreset();
            });
            $from.add($to).on('change input', markPreset);

            $session.on('change', function () { applySessionBounds(); loadSections(); });
            $class.on('change', loadSections);

            $('#dueForm').on('submit', function (e) {
                if ($from.val() && $to.val() && $from.val() > $to.val()) {
                    e.preventDefault();
                    $('[data-valmsg-for="ToDate"]').text("The 'To' date must be on or after the 'From' date.");
                    $to.addClass('is-invalid').trigger('focus');
                    return false;
                }
                $to.removeClass('is-invalid');
            });
            // Disabled selects are not posted; the model binder then treats them as 0 ("all").
            DueList.busyOnSubmit('#dueForm', '#loadBtn');

            applySessionBounds();
            DueList.init({ exportUrl: exportUrl, applied: applied });
        })();
    </script>
}
