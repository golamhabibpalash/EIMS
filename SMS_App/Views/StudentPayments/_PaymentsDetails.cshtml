@model SMS.Entities.AdditionalModels.SinglePaymentVM

@using SMS.Entities.Enums

@{
    int trCount = 1;
    var dueAmountClass = "";
    var collapsedShow = "";
    collapsedShow = Model.AcademicSession == Model.CurrentSession?"show":"";
    if (Model.TotalDueAmount > 0)
    {
        dueAmountClass = "text-warning";
    }

}
    <div class="card border-dark">
        <div class="card-header text-center bg-gradient btn" data-bs-toggle="collapse" data-bs-target=".collapsedTable_@Model.AcademicSession" id="accordionCard" area-control="collapse_full">
            <p class="card-title h5">Payments For @Model.AcademicSession <i class="fa fa-chevron-down"></i> </p>
        </div>
        <table class="table table-dark table-bordered collapsedTable_@Model.AcademicSession collapse @collapsedShow" id="accordion" data-parent="#accordionCard">
            <thead class="thead-dark">
                <tr>
                    <th style="width:5%">#</th>
                    <th style="width:40%">Payment type</th>
                    <th style="width:10%" class="text-right">Amount</th>
                    <th style="width:10%" class="text-right">Paid</th>
                    <th style="width:10%" class="text-right">Due</th>
                    <th style="width:10%">Status</th>
                    <th style="width:15%">Action</th>    
                    
                </tr>
            </thead>
            <tbody>
                @if (Model.SessionWisePaymentVMs?.Count > 0)
                {
                    foreach (var item in Model.SessionWisePaymentVMs)
                    {
                        if (item.Amount==0)
                    {
                        continue;
                    }
                        <tr class="card-header table-active font-weight-bold" data-bs-toggle="collapse" data-bs-target=".tr_@trCount" area-control="collapse_@trCount" aria-expanded="false">
                            <td>@trCount</td>
                            <td>@item.FeeHeadName <span class="badge badge-info">@(item.SessionWisePaymentDetails?.Count ?? 0)</span></td>
                            <td class="text-right">@item.Amount</td>
                            <td class="text-right">@item.PaidAmount</td>
                            <td class="text-right">@item.Balance</td>
                            @{
                                var iStatusClass = "";
                                if (item.Status == StudentPaymentStatus.Paid.ToString())
                                {
                                    iStatusClass = "text-success";
                                }
                                else if (item.Status == StudentPaymentStatus.Unpaid.ToString())
                                {
                                    iStatusClass = "text-danger";
                                }
                                else if (item.Status == StudentPaymentStatus.Partial.ToString())
                                {
                                    iStatusClass = "text-warning";
                                }
                            }
                            <td class="@iStatusClass">@item.Status</td>
                            <td class="p-0">
                                @if (item.Status == StudentPaymentStatus.Paid.ToString() || item.Status == StudentPaymentStatus.Partial.ToString())
                                {
                                    <span class="btn btn-sm btn-info toggle-icon m-2" data-bs-target=".tr_@trCount">
                                        <i class="fa fa-chevron-down"></i>
                                    </span>
                                }                                                        
                            </td>
                        </tr>
                        @if (item.SessionWisePaymentDetails?.Count > 0)
                        {
                            <tr class="collapse tr_@trCount card-body table-sm table-light text-dark" data-bs-parent="#accordion">
                                <td colspan="7" class="text-center">
                                    <span class="font-weight-bold">Breakdowns</span>
                                </td>
                            </tr>
                            foreach (var dItem in item.SessionWisePaymentDetails)
                            {
                                <tr class="collapse tr_@trCount  card-body  multi-collapse table-sm table-light text-dark" data-bs-parent="#accordion">
                                    <td colspan="1">
                                        <span class="alert">#@dItem.ReceiptNo</span>
                                        <span class="alert">Paid Date: @dItem.PaidDate</span>
                                    </td>
                                    <td class="text-right"><span>@dItem.PayableAmount</span></td>
                                    <td class="text-right"><span> @dItem.PaidAmount</span></td>
                                    <td class="text-right"><span> @dItem.DueAmount</span></td>
                                    @{ 
                                        var statusClass = "";
                                        if (dItem.Status == StudentPaymentStatus.Paid.ToString())
                                        {
                                            statusClass = "text-success";
                                        }
                                        else if(dItem.Status == StudentPaymentStatus.Unpaid.ToString())
                                        {
                                            statusClass = "text-danger";
                                        }
                                        else if(dItem.Status == StudentPaymentStatus.Partial.ToString())
                                        {
                                            statusClass = "text-warning";
                                        }
                                    }
                                    <td class="@statusClass"><span> @dItem.Status</span></td>
                                    <td class="">
                                        @if (Model.AcademicSession == Model.CurrentSession)
                                        {
                                            <span class="m-2 editBtn" data-id="@dItem.PaymentDetailId" data-bs-toggle="modal" data-bs-target=".paymentUpdateModal1" style="cursor:pointer">
                                                <i class="text-warning fa fa-edit fa-2x"></i>
                                            </span> 
                                        }
                                        @if (item.Status != StudentPaymentStatus.Unpaid.ToString())
                                        {
                                            <span class="m-0 modalViewId" data-paymentid="@dItem.PaymentId" data-bs-target="#exampleModalCenter" data-bs-toggle="modal" style="cursor:pointer"><i class="fa fa-print fa-2x"></i></span>
                                        }
                                    </td>
                                </tr>
                                if (!string.IsNullOrEmpty(dItem.Remarks))
                                {
                                    <tr class="collapse tr_@trCount border card-body table-sm table-light text-dark" data-bs-parent="#accordion">
                                        <td class="p-0 pl-2" colspan="7">Remarks:<span class="font-italic"> @dItem.Remarks</span></td>
                                    </tr>
                                }
                            }
                        }
                        trCount++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">
                            <h6>Data not found</h6>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="bg-dark text-light">
                <tr class="font-weight-bolder">
                    <td colspan="2" class="text-right">Total</td>
                    <td class="text-right">@Model.TotalAmount</td>
                    <td class="text-right">@Model.TotalPaidAmount</td>
                    <td class="text-right @dueAmountClass">@Model.TotalDueAmount</td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        </table>
    </div>