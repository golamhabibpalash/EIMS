@section Styles {
    <style>
        body {
            background-color: #f0f2f5; /* Light grey modern background */
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }

        .card {
            border: none;
            border-radius: 12px; /* Softer corners */
            box-shadow: 0 4px 20px rgba(0,0,0,0.05); /* Subtle shadow */
        }

        .btn-primary {
            background-color: #0d6efd;
            padding: 10px 20px;
            font-weight: 500;
        }
    </style>
    }
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">

                <div class="card p-4 p-md-5">

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 fw-bold text-dark">New Payment</h4>
                        <span class="badge bg-light text-secondary border">ID: #8392</span>
                    </div>

                    <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <div class="small">
                            Please input separate payments according to payment type.
                        </div>
                    </div>

                    <form>
                        <div class="row g-3">

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="date" class="form-control" id="dateInput" value="2026-01-20">
                                    <label for="dateInput">Date</label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select class="form-select" id="paymentSelect">
                                        <option selected>Select Payment...</option>
                                        <option value="1">Invoice #001</option>
                                        <option value="2">Service Charge</option>
                                    </select>
                                    <label for="paymentSelect">Payment For</label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Amount</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bi bi-currency-dollar"></i></span>
                                    <input type="number" class="form-control form-control-lg" placeholder="0.00">
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Total (Auto-calc)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-calculator"></i></span>
                                    <input type="number" class="form-control form-control-lg bg-light" value="0" readonly>
                                </div>
                            </div>

                            <div class="col-12 mt-4">
                                <label class="form-label small text-muted">Remark</label>
                                <textarea class="form-control" rows="3" placeholder="Add any additional notes here..."></textarea>
                            </div>

                            <div class="col-12 mt-4 d-flex justify-content-between align-items-center">

                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="smsSwitch" checked>
                                    <label class="form-check-label" for="smsSwitch">Send SMS Notification</label>
                                </div>

                                <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                    <i class="bi bi-check2-circle me-1"></i> Submit Payment
                                </button>
                            </div>

                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
