@using SMS.Entities.AdditionalModels.Finance;
@using SMS_App.Utilities.Export;
@model DuePaymentPreviousDto
@{
    ViewData["Title"] = "Due Payment (Previous)";
    bool isFromPost = ViewBag.isFromPost ?? false;
    var dues = Model.DuePayments ?? new List<DuePayment>();
    bool hasRows = dues.Count > 0;

    double totalPayable = dues.Sum(d => d.PayableAmount);
    double totalPaid = dues.Sum(d => d.PaidAmount);
    double totalDue = dues.Sum(d => d.TotalDue);

    string scopeClass = Model.AcademicClass?.Name ?? "All classes";
    string scopeSection = Model.AcademicSection != null ? $"Section {Model.AcademicSection.Name}" : "All sections";
    string scopeStatus = Model.Status switch { "1" => "Active students", "0" => "Inactive students", _ => "Active and inactive students" };

    // Column order here must match the data-sort-key values, which must match PreviousDueExport keys.
    int dueColumnIndex = 10;
}
@section Styles {
    <style>
        .due-summary .card { border-left: 4px solid var(--bs-primary); }
        .due-summary .card.due-paid { border-left-color: var(--bs-success); }
        .due-summary .card.due-total { border-left-color: var(--bs-danger); }
        .due-summary .label { font-size: .75rem; text-transform: uppercase; letter-spacing: .04em; color: var(--bs-secondary-color, #6c757d); }
        .due-summary .value { font-size: 1.35rem; font-weight: 600; }
        #previousDueTable td.amount, #previousDueTable th.amount { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
        #previousDueTable tr.is-inactive td { color: var(--bs-secondary-color, #6c757d); }
        #previousDueTable tfoot th { border-top: 2px solid currentColor; }
        #previousDueTable .row-actions { white-space: nowrap; }
        .report-heading img { width: 64px; height: 64px; object-fit: contain; }
        @@media print {
            .no-print, .dataTables_length, .dataTables_filter, .dataTables_paginate, .dataTables_info { display: none !important; }
            #previousDueTable .row-actions { display: none; }
        }
    </style>
}

<div class="card shadow-sm mb-3 no-print">
    <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h5 class="mb-0"><i class="fa fa-money-bill-wave me-2"></i> Due Payment (Previous)</h5>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="printBtn" @(hasRows ? "" : "disabled")
                    title="Print the list as shown">
                <i class="fa fa-print"></i> Print
            </button>
            <div class="btn-group btn-group-sm">
                <button type="button" class="btn btn-success dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"
                        id="exportBtn" @(hasRows ? "" : "disabled")
                        title="@(hasRows ? "Download the list in its current order and search" : "Load a list first")">
                    <i class="fa fa-download"></i> Export
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="exportBtn">
                    <li><a class="dropdown-item export-link" href="#" data-format="xlsx"><i class="fa fa-file-excel text-success me-2"></i> Excel (.xlsx)</a></li>
                    <li><a class="dropdown-item export-link" href="#" data-format="csv"><i class="fa fa-file-csv text-primary me-2"></i> CSV</a></li>
                    <li><a class="dropdown-item export-link" href="#" data-format="pdf"><i class="fa fa-file-pdf text-danger me-2"></i> PDF</a></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="card-body py-3">
        <form id="previousDueForm" asp-action="DuePaymentPrevious" method="post">
            <div class="row g-2 align-items-end">
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                    <label for="AcademicClassId" class="form-label mb-1 small text-muted">Class</label>
                    <select class="form-select form-select-sm" asp-for="AcademicClassId" asp-items="Model.AcademicClassList">
                        <option value="0">All classes</option>
                    </select>
                </div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                    <label for="AcademicSectionId" class="form-label mb-1 small text-muted">Section</label>
                    <select class="form-select form-select-sm" asp-for="AcademicSectionId" asp-items="Model.AcademicSectionList"
                            disabled="@(Model.AcademicClassId > 0 ? null : "disabled")">
                        <option value="0">All sections</option>
                    </select>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-4 col-sm-6">
                    <label for="StudentId" class="form-label mb-1 small text-muted">Student</label>
                    <select class="form-select form-select-sm" asp-for="StudentId" asp-items="Model.StudentList"
                            disabled="@(Model.AcademicClassId > 0 ? null : "disabled")">
                        <option value="0">All students</option>
                    </select>
                </div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                    <label for="Status" class="form-label mb-1 small text-muted">Student status</label>
                    <select class="form-select form-select-sm" asp-for="Status">
                        <option value="1">Active</option>
                        <option value="0">Inactive</option>
                        <option value="-1">All</option>
                    </select>
                </div>
                <div class="col-xl-2 col-lg-6 col-md-4 col-sm-6">
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" role="switch" asp-for="DueOnly">
                        <label class="form-check-label small" for="DueOnly">Only students with a due</label>
                    </div>
                </div>
                <div class="col-xl-1 col-lg-6 col-md-4 col-sm-6 text-end">
                    <button type="submit" id="loadBtn" class="btn btn-primary btn-sm w-100">
                        <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                        <span class="btn-label"><i class="fa fa-search"></i> Get list</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (hasRows)
{
    <div class="row g-3 mb-3 due-summary no-print">
        <div class="col-lg-3 col-sm-6">
            <div class="card shadow-sm h-100"><div class="card-body py-2">
                <div class="label">Students</div>
                <div class="value" id="sumCount">@dues.Count</div>
            </div></div>
        </div>
        <div class="col-lg-3 col-sm-6">
            <div class="card shadow-sm h-100"><div class="card-body py-2">
                <div class="label">Total payable</div>
                <div class="value" id="sumPayable">@PreviousDueExport.Amount(totalPayable)</div>
            </div></div>
        </div>
        <div class="col-lg-3 col-sm-6">
            <div class="card shadow-sm h-100 due-paid"><div class="card-body py-2">
                <div class="label">Total paid</div>
                <div class="value text-success" id="sumPaid">@PreviousDueExport.Amount(totalPaid)</div>
            </div></div>
        </div>
        <div class="col-lg-3 col-sm-6">
            <div class="card shadow-sm h-100 due-total"><div class="card-body py-2">
                <div class="label">Total due</div>
                <div class="value text-danger" id="sumDue">@PreviousDueExport.Amount(totalDue)</div>
            </div></div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="report-heading d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 pb-2 border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <img src="~/Images/Institute/@Model.Institute?.Logo" alt="Institute logo"
                         onerror="this.onerror=null;this.src='/images/institute/smslogo.png';" />
                    <div>
                        <h5 class="mb-0">@Model.Institute?.Name</h5>
                        <div class="small text-muted">@Model.Institute?.Address</div>
                        <div class="small fw-semibold mt-1">Previous Due Payments (all sessions)</div>
                    </div>
                </div>
                <div class="text-md-end small">
                    <div>@scopeClass &middot; @scopeSection</div>
                    @if (Model.Student != null)
                    {
                        <div>@Model.Student.ClassRoll - @Model.Student.Name</div>
                    }
                    <div>@(scopeStatus + (Model.DueOnly ? ", with a due" : ""))</div>
                    <div class="text-muted">Date: @DateTime.Now.ToString("dd MMM yyyy")</div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-sm table-hover table-striped align-middle w-100" id="previousDueTable">
                    <thead class="table-light">
                        <tr>
                            <th class="no-sort" scope="col">#</th>
                            <th data-sort-key="roll" scope="col">Roll</th>
                            <th data-sort-key="uniqueId" scope="col">Unique ID</th>
                            <th data-sort-key="name" scope="col">Student name</th>
                            <th data-sort-key="class" scope="col">Class</th>
                            <th data-sort-key="section" scope="col">Section</th>
                            <th data-sort-key="phone" scope="col">Contact no</th>
                            <th data-sort-key="status" scope="col">Status</th>
                            <th data-sort-key="payable" class="amount" scope="col">Payable</th>
                            <th data-sort-key="paid" class="amount" scope="col">Paid</th>
                            <th data-sort-key="due" class="amount" scope="col">Due</th>
                            <th class="no-sort text-center" scope="col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in dues)
                        {
                            var st = item.Student;
                            var phone = PreviousDueExport.All.First(c => c.Key == "phone").Text(item);
                            <tr class="@(st.Status ? "" : "is-inactive")">
                                <td></td>
                                <td>@st.ClassRoll</td>
                                <td>@st.UniqueId</td>
                                <td>@st.Name</td>
                                <td>@(st.AcademicClass?.Name ?? "N/A")</td>
                                <td>@(st.AcademicSection?.Name ?? "N/A")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(phone))
                                    {
                                        <a href="tel:@phone">@phone</a>
                                    }
                                </td>
                                <td data-order="@(st.Status ? 0 : 1)">
                                    @if (st.Status)
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis">Inactive</span>
                                    }
                                </td>
                                <td class="amount" data-order="@item.PayableAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)">@PreviousDueExport.Amount(item.PayableAmount)</td>
                                <td class="amount" data-order="@item.PaidAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)">@PreviousDueExport.Amount(item.PaidAmount)</td>
                                <td class="amount fw-semibold @(item.TotalDue > 0 ? "text-danger" : "text-success")"
                                    data-order="@item.TotalDue.ToString(System.Globalization.CultureInfo.InvariantCulture)">@PreviousDueExport.Amount(item.TotalDue)</td>
                                <td class="text-center row-actions">
                                    <a class="btn btn-outline-info btn-sm py-0 px-1" target="_blank" title="Payment statement (PDF)" aria-label="Payment statement for @st.Name"
                                       asp-action="StudentPaymentInfoExport" asp-controller="Reports" asp-route-reportType="pdf"
                                       asp-route-fileName="payment_report_@st.ClassRoll" asp-route-classRoll="@st.ClassRoll"
                                       asp-route-fromDate="@st.AdmissionDate.ToString("dd-MM-yyyy")" asp-route-toDate="@DateTime.Today.ToString("dd-MM-yyyy")">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                    <a class="btn btn-outline-primary btn-sm py-0 px-1" title="Student financial details" aria-label="Financial details for @st.Name"
                                       asp-action="Details" asp-controller="Students" asp-fragment="financials" asp-route-tabName="financials" asp-route-id="@st.Id">
                                        <i class="fa fa-info"></i>
                                    </a>
                                    <a class="btn btn-success btn-sm py-0 px-2" title="Take payment" aria-label="Take payment from @st.Name"
                                       asp-action="Payment" asp-controller="StudentPayments" asp-route-stRoll="@st.ClassRoll">Pay</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="8" class="text-end">Total (<span id="footCount">@dues.Count</span> students)</th>
                            <th class="amount" id="footPayable">@PreviousDueExport.Amount(totalPayable)</th>
                            <th class="amount" id="footPaid">@PreviousDueExport.Amount(totalPaid)</th>
                            <th class="amount text-danger" id="footDue">@PreviousDueExport.Amount(totalDue)</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5 text-muted">
            @if (isFromPost)
            {
                <i class="fa fa-check-circle fa-2x text-success mb-2"></i>
                <h6 class="mb-1">No dues found</h6>
                <p class="mb-0 small">@(Model.DueOnly ? "No student matching these filters has an outstanding due." : "No student matches these filters.") Try another class or status.</p>
            }
            else
            {
                <i class="fa fa-filter fa-2x mb-2"></i>
                <h6 class="mb-1">Choose filters and select <strong>Get list</strong></h6>
                <p class="mb-0 small">Dues are totalled across all sessions for each student's current class.</p>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            const sectionsUrl = '/api/academicsections/getbyclasswithsessionId';
            const studentsUrl = '@Url.Action("GetStudentsBySessionIdClassIdSectionId", "Students")';
            const exportUrl = '@Url.Action("DuePaymentPreviousExport", "StudentPayments")';

            // Filters the CURRENT list was loaded with (not the live form, which the user may have
            // changed without reloading), so an export always matches the rows on screen.
            const applied = {
                academicClassId: '@Model.AcademicClassId',
                academicSectionId: '@Model.AcademicSectionId',
                studentId: '@Model.StudentId',
                status: '@Model.Status',
                dueOnly: '@Model.DueOnly.ToString().ToLowerInvariant()'
            };

            const $class = $('#AcademicClassId'), $section = $('#AcademicSectionId'), $student = $('#StudentId');

            function resetSelect($el, allText, disabled) {
                $el.empty().append($('<option>').val('0').text(allText)).prop('disabled', disabled);
            }

            function loadStudents() {
                const classId = $class.val();
                resetSelect($student, 'All students', true);
                if (!classId || classId === '0') return;
                const p = new URLSearchParams({ academicClassId: classId, academicSectionId: $section.val() || '0' });
                $student.prop('disabled', true).find('option').first().text('Loading…');
                $.ajax({ url: studentsUrl + '?' + p.toString(), type: 'POST', dataType: 'json', cache: false })
                    .done(function (data) {
                        resetSelect($student, 'All students', false);
                        $.each(data || [], function (_, s) {
                            $student.append($('<option>').val(s.id).text(s.classRoll + ' - ' + s.name));
                        });
                    })
                    .fail(function () { resetSelect($student, 'Could not load students', false); });
            }

            $class.on('change', function () {
                const classId = $class.val();
                resetSelect($section, 'All sections', true);
                if (!classId || classId === '0') { resetSelect($student, 'All students', true); return; }
                $section.find('option').first().text('Loading…');
                $.ajax({ url: sectionsUrl + '?classId=' + encodeURIComponent(classId) + '&sessionId=0', type: 'POST', dataType: 'json', cache: false })
                    .done(function (data) {
                        resetSelect($section, 'All sections', false);
                        $.each(data || [], function (_, s) { $section.append($('<option>').val(s.id).text(s.name)); });
                    })
                    .fail(function () { resetSelect($section, 'Could not load sections', false); })
                    .always(loadStudents);
            });
            $section.on('change', loadStudents);

            // Disabled selects are not posted; the model binder then treats them as 0 ("all").
            $('#previousDueForm').on('submit', function () {
                const $btn = $('#loadBtn').prop('disabled', true);
                $btn.find('.spinner-border').removeClass('d-none');
                $btn.find('.btn-label').text(' Loading…');
            });

            const $table = $('#previousDueTable');
            if (!$table.length || !$.fn.DataTable) return;

            const amountFormat = new Intl.NumberFormat('en-US', { maximumFractionDigits: 2 });
            const amountCols = { payable: 8, paid: 9, due: @dueColumnIndex };

            const table = $table.DataTable({
                order: [[@dueColumnIndex, 'desc']],
                pageLength: 50,
                lengthMenu: [[25, 50, 100, -1], [25, 50, 100, 'All']],
                columnDefs: [
                    { targets: 'no-sort', orderable: false, searchable: false },
                    // IDs and phone numbers sort as text, the same way the export sorts them.
                    { targets: [2, 6], type: 'string' }
                ],
                language: { search: '', searchPlaceholder: 'Search name, roll, ID, phone…', emptyTable: 'No dues found', zeroRecords: 'No students match your search' },
                drawCallback: function () {
                    const api = this.api();
                    // Serial numbers follow the current sort and search, not the original order.
                    api.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) { cell.textContent = i + 1; });

                    // Totals (summary cards and footer) follow the quick search.
                    const rows = api.rows({ search: 'applied' });
                    const sum = function (idx) {
                        return api.cells(rows.indexes(), idx).nodes().toArray()
                            .reduce(function (a, td) { return a + (parseFloat(td.getAttribute('data-order')) || 0); }, 0);
                    };
                    const count = rows.count();
                    const payable = amountFormat.format(sum(amountCols.payable));
                    const paid = amountFormat.format(sum(amountCols.paid));
                    const due = amountFormat.format(sum(amountCols.due));
                    $('#sumCount, #footCount').text(count);
                    $('#sumPayable, #footPayable').text(payable);
                    $('#sumPaid, #footPaid').text(paid);
                    $('#sumDue, #footDue').text(due);
                }
            });

            $('.export-link').on('click', function (e) {
                e.preventDefault();
                const p = new URLSearchParams(applied);
                const order = table.order()[0];
                if (order) {
                    const key = $(table.column(order[0]).header()).data('sort-key');
                    if (key) { p.set('sortBy', key); p.set('sortDir', order[1]); }
                }
                if (table.search()) p.set('search', table.search());
                p.set('format', $(this).data('format'));
                window.location.href = exportUrl + '?' + p.toString();
            });

            $('#printBtn').on('click', function () {
                // Print every matching row, not just the current page, then restore paging.
                const length = table.page.len();
                table.page.len(-1).draw(false);
                window.print();
                table.page.len(length).draw(false);
            });
        })();
    </script>
}
