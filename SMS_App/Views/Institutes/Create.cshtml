@model SMS.Entities.Institute

@{
    GlobalUI.PageTitle = "Add Institution information";
    ViewData["Title"] = "Institution information";
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" enctype="multipart/form-data" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group row">
                <label asp-for="Name" class="control-label col-md-2 text-md-end col-form-label"></label>
                <div class="col-md-8">
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

@*            <div class="form-group row">
                <label asp-for="ISO" class="control-label col-md-2 text-md-end col-form-label"></label>
                <div class="col-md-8">
                    <input asp-for="ISO" class="form-control" />
                    <span asp-validation-for="ISO" class="text-danger"></span>
                </div>
            </div>*@

            <div class="form-group row">
                <label asp-for="EIIN" class="control-label col-md-2 text-md-end col-form-label"></label>
                <div class="col-md-8">
                    <input asp-for="EIIN" class="form-control" />
                    <span asp-validation-for="EIIN" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row">
                <label asp-for="Slogan" class="control-label col-md-2 text-md-end col-form-label"></label>
                <div class="col-md-8">
                    <input asp-for="Slogan" class="form-control" />
                    <span asp-validation-for="Slogan" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="Banner" class="control-label col-md-2 text-md-end col-form-label"></label>
                <div class="col-md-8 input-group">
                    <div class="custom-file">
                        <input name="banner" type="file" class="custom-file-input" id="inputGroupFile01">
                        <label class="custom-file-label" for="inputGroupFile01">Choose file</label>
                    </div>
                    <span asp-validation-for="Banner" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="Logo" class="control-label col-md-2 text-md-end col-form-label"></label>
                <div class="input-group col-md-8">
                    <div class="custom-file">
                        <input name="logo" type="file" class="custom-file-input" id="inputGroupFile02">
                        <label class="custom-file-label" for="inputGroupFile02">Choose file</label>
                    </div>
                    <span asp-validation-for="Logo" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="Address" class="control-label col-md-2 text-md-end col-form-label"></label>
                <div class="col-md-8">
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="BranchName" class="control-label col-md-2 text-md-end col-form-label">Branch Name</label>
                <div class="col-md-8">
                    <input asp-for="BranchName" class="form-control" />
                    <span asp-validation-for="BranchName" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-2 offset-md-2">
                    <input type="submit" value="Create" class="btn btn-primary btn-sm" />
                </div>
            </div>
        </form>
    </div>
    <div class="col-md-6">
        <div id="photoDiv" style="display:none">
            <label>Banner :<img class="img-fluid" id="sPhotoId" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="Banner" style="height:130px;" /></label>
            
        </div>
        <div id="logoDiv" style="display:none">
            <label>Logo: <img class="img-fluid" id="sLogoId" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="Logo" style="height:130px;" /></label>
            
        </div>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
<script>
    $(document).ready(function () {
        function readURL(input, idName) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();

                reader.onload = function (e) {
                    $(idName).attr('src', e.target.result);
                }

                reader.readAsDataURL(input.files[0]); // convert to base64 string
            }
        }
        $("#inputGroupFile01").change(function () {
            $("#photoDiv").show();
            let imgId = "#sPhotoId";
            readURL(this, imgId);
        });
        $("#inputGroupFile02").change(function () {
            $("#logoDiv").show();
            let imgId = "#sLogoId";
            readURL(this, imgId);
        });
    });
</script>
}
