@model SMS.Entities.Institute
@using SMS.Entities
@using SMS.Entities.Enums

@{
    ViewData["Title"] = "Institute information";
    GlobalUI.PageTitle = ViewBag.Title;

    var instituteLinks = ViewBag.InstituteLinks as List<InstituteLink> ?? new List<InstituteLink>();
}
<div class="row p-2">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <img src="~/Images/Institute/@Model.Logo" alt="Institute Logo" style="max-width:200px;" />
            </div>
            <div class="card-footer text-center">
                <span class="h3">@Model.Name</span>
            </div>
        </div>
    </div>
    <div class="col-md-8 well shadow mb-0 pb-0">
        <h4><i class="fas fa-cog"></i> General Informations</h4>
        <table class="table table-striped table-hover mb-0" style="color:#000000">
            <thead class="bg-navy-blue">
                <tr>
                    <td class="" style="width:fit-content">Items</td>
                    <td></td>
                    <td width="80%">Information</td>
                </tr>
            </thead>
            <tbody>

                <tr class="">
                    <td>@Html.DisplayNameFor(model => model.Name)</td>
                    <td>:</td>
                    <td>@Html.DisplayFor(modelItem => modelItem.Name)</td>
                </tr>

                <tr>
                    <td>@Html.DisplayNameFor(model => model.ShortName)</td>
                    <td>:</td>
                    <td>@Html.DisplayFor(modelItem => modelItem.ShortName)</td>
                </tr>

                <tr>
                    <td>@Html.DisplayNameFor(model => model.EIIN)</td>
                    <td>:</td>
                    <td>@Html.DisplayFor(modelItem => modelItem.EIIN)</td>
                </tr>
                <tr>
                    <td>@Html.DisplayNameFor(model => model.Slogan)</td>
                    <td>:</td>
                    <td>@Html.DisplayFor(modelItem => modelItem.Slogan)</td>
                </tr>
                <tr>
                    <td>@Html.DisplayNameFor(model => model.Banner)</td>
                    <td>:</td>
                    <td><img src="~/Images/Institute/@Model.Banner" alt="Institute Banner" style="max-height:100px" ; /></td>
                </tr>
                <tr>
                    <td>@Html.DisplayNameFor(model => model.FavIcon)</td>
                    <td>:</td>
                    <td><img src="~/Images/Institute/@Model.FavIcon" alt="Title Icon" style="max-height:100px" ; /></td>
                </tr>
               

                <tr>
                    <td>@Html.DisplayNameFor(model => model.Address)</td>
                    <td>:</td>
                    <td>@Html.DisplayFor(modelItem => modelItem.Address)</td>
                </tr>
                <tr>
                    <td>@Html.DisplayNameFor(model => model.BranchName)</td>
                    <td>:</td>
                    <td>@Model.BranchName?.ToString()</td>
                </tr>
                <tr>
                    <td>@Html.DisplayNameFor(model => model.Phone1)</td>
                    <td>:</td>
                    @if (string.IsNullOrEmpty(Model.Phone1))
                    {
                        <td></td>
                    }
                    else
                    {
                        <td>
                            @Model.Phone1.ToString()
                        </td>
                    }
                </tr>
                <tr>
                    <td>@Html.DisplayNameFor(model => model.Phone2)</td>
                    <td>:</td>
                    @if (string.IsNullOrEmpty(Model.Phone2))
                    {
                        <td></td>
                    }
                    else
                    {
                        <td>
                            @Model.Phone2.ToString()
                        </td>
                    }
                </tr>
                <tr>
                    <td>@Html.DisplayNameFor(model => model.Email)</td>
                    <td>:</td>
                    @if (string.IsNullOrEmpty(Model.Email))
                    {
                        <td></td>
                    }
                    else
                    {
                        <td>
                            @Model.Email.ToString()
                        </td>
                    }
                </tr>
                <tr>
                    <td>@Html.DisplayNameFor(model => model.StartingTime)</td>
                    <td>:</td>
                    <td>@Model.StartingTime.ToString("hh:mm:ss tt")</td>
                </tr>
                <tr>
                    <td>@Html.DisplayNameFor(model => model.ClosingTime)</td>
                    <td>:</td>
                    <td>@Model.ClosingTime.ToString("hh:mm:ss tt")</td>
                </tr>
                <tr>
                    <td>@Html.DisplayNameFor(model => model.LateTime)</td>
                    <td>:</td>
                    <td>@Model.LateTime.ToString("hh:mm:ss tt")</td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td></td>
                    <td></td>
                    <td>
                        <div class="col-sm-12 col-md-12 text-md-end text-sm-center">
                            @*<a asp-action="Edit" asp-controller="Institutes" asp-route-id="@Model.Id" class="btn btn-sm btn-success"><i class="fa fa-edit"></i> Edit Info</a>*@
                            <button type="button" class="btn btn-sm btn-navy-blue" data-bs-toggle="modal" data-bs-target=".bd-example-modal-lg"><i class="fas fa-edit"></i> Edit</button>
                        </div>
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
@*Links & Social Media*@
<div class="row p-2">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header bg-navy-blue d-flex justify-content-between align-items-center">
                <span class="h4 text-light mb-0"><i class="fas fa-link"></i> Links &amp; Social Media</span>
                <button type="button" class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#addLinkModal">
                    <i class="fas fa-plus"></i> Add Link
                </button>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0" style="color:#000000">
                    <thead class="bg-navy-blue">
                        <tr>
                            <td style="width:60px">Order</td>
                            <td>Title</td>
                            <td>Type</td>
                            <td>URL</td>
                            <td style="width:90px">Status</td>
                            <td style="width:160px" class="text-end">Actions</td>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!instituteLinks.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted p-3">No links added yet.</td></tr>
                        }
                        @foreach (var link in instituteLinks)
                        {
                            <tr>
                                <td>@link.DisplayOrder</td>
                                <td>@link.LinkTitle</td>
                                <td>@link.LinkType</td>
                                <td><a href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Url</a></td>
                                <td>
                                    @if (link.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-navy-blue edit-link-btn"
                                            data-id="@link.Id"
                                            data-title="@link.LinkTitle"
                                            data-type="@((int)link.LinkType)"
                                            data-url="@link.Url"
                                            data-order="@link.DisplayOrder"
                                            data-active="@link.IsActive.ToString().ToLower()"
                                            title="Edit"><i class="fas fa-edit"></i></button>
                                    <form asp-action="ToggleActive" asp-controller="InstituteLinks" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@link.Id" />
                                        <button type="submit" class="btn btn-sm btn-warning" title="@(link.IsActive ? "Disable" : "Enable")">
                                            <i class="fas fa-@(link.IsActive ? "toggle-off" : "toggle-on")"></i>
                                        </button>
                                    </form>
                                    <form asp-action="Delete" asp-controller="InstituteLinks" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this link?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@link.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger" title="Delete"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@*Add link modal*@
<div class="modal fade" id="addLinkModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" asp-controller="InstituteLinks" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-navy-blue">
                    <span class="h5 text-light">Add Link</span>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label">Link Title</label>
                        <input name="LinkTitle" class="form-control" maxlength="100" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Link Type</label>
                        <select name="LinkType" class="form-control" asp-items="Html.GetEnumSelectList<InstituteLinkType>()"></select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">URL</label>
                        <input name="Url" type="url" class="form-control" maxlength="2048" placeholder="https://example.com" required />
                    </div>
                    <div class="row">
                        <div class="col-6 mb-2">
                            <label class="form-label">Display Order</label>
                            <input name="DisplayOrder" type="number" min="0" value="0" class="form-control" />
                        </div>
                        <div class="col-6 mb-2 d-flex align-items-end">
                            <div class="form-check">
                                <input name="IsActive" value="true" type="checkbox" class="form-check-input" id="addIsActive" checked />
                                <input name="IsActive" value="false" type="hidden" />
                                <label class="form-check-label" for="addIsActive">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-sm btn-navy-blue"><i class="fas fa-save"></i> Save</button>
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

@*Edit link modal*@
<div class="modal fade" id="editLinkModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Edit" asp-controller="InstituteLinks" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editLinkId" />
                <div class="modal-header bg-navy-blue">
                    <span class="h5 text-light">Edit Link</span>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label">Link Title</label>
                        <input name="LinkTitle" id="editLinkTitle" class="form-control" maxlength="100" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Link Type</label>
                        <select name="LinkType" id="editLinkType" class="form-control" asp-items="Html.GetEnumSelectList<InstituteLinkType>()"></select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">URL</label>
                        <input name="Url" id="editLinkUrl" type="url" class="form-control" maxlength="2048" required />
                    </div>
                    <div class="row">
                        <div class="col-6 mb-2">
                            <label class="form-label">Display Order</label>
                            <input name="DisplayOrder" id="editLinkOrder" type="number" min="0" class="form-control" />
                        </div>
                        <div class="col-6 mb-2 d-flex align-items-end">
                            <div class="form-check">
                                <input name="IsActive" value="true" type="checkbox" class="form-check-input" id="editIsActive" />
                                <input name="IsActive" value="false" type="hidden" />
                                <label class="form-check-label" for="editIsActive">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-sm btn-navy-blue"><i class="fas fa-save"></i> Update</button>
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

@*Edit modal*@
<div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="row">
                <div class="col-md-12 card p-0">
                    <form asp-action="Edit" asp-controller="Institutes" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="card-header bg-navy-blue">
                            <span class="h4 text-light">Update General Information</span>
                            <button type="button" class="btn-close float-end" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <input type="hidden" asp-for="Id" />
                            <div class="row mb-2">
                                <label asp-for="Name" class="col-md-2 col-form-label text-md-end"></label>
                                <div class="col-md-10">
                                    <input spellcheck="true" asp-for="Name" class="form-control" />
                                </div>
                            </div>
                            <div class="row mb-2">
                                <label asp-for="ShortName" class="col-md-2 col-form-label text-md-end"></label>
                                <div class="col-md-4">
                                    <input spellcheck="true" asp-for="ShortName" class="form-control" />
                                </div>
                            </div>
                            <div class="row mb-2">
                                <label asp-for="EIIN" class="col-md-2 col-form-label text-md-end"></label>
                                <div class="col-md-4">
                                    <input asp-for="EIIN" class="form-control" />
                                </div>

                                <label asp-for="BranchName" class="col-md-2 col-form-label text-md-end"></label>
                                <div class="col-md-4">
                                    <input asp-for="BranchName" class="form-control" />
                                </div>
                            </div>
                            <div class="row mb-2">
                                <label asp-for="Phone1" class="col-md-2 col-form-label text-md-end"></label>
                                <div class="col-md-4">
                                    <input asp-for="Phone1" class="form-control" />
                                </div>

                                <label asp-for="Phone2" class="col-md-2 col-form-label text-md-end"></label>
                                <div class="col-md-4">
                                    <input asp-for="Phone2" class="form-control" />
                                </div>
                            </div>
                            <div class="row mb-2">
                                <label asp-for="Email" class="col-md-2 col-form-label text-md-end"></label>
                                <div class="col-md-4">
                                    <input asp-for="Email" class="form-control" />
                                </div>

                                <label asp-for="Slogan" class="col-md-2 col-form-label text-md-end"></label>
                                <div class="col-md-4">
                                    <input asp-for="Slogan" class="form-control" />
                                </div>
                            </div>
                            <div class="row mb-2">
                                <label asp-for="Address" class="col-md-2 col-form-label text-md-end"></label>
                                <div class="col-md-10">
                                    <input asp-for="Address" class="form-control" />
                                </div>
                            </div>
                            <div class="row mb-2">
                                <label asp-for="StartingTime" class="col-md-2 col-form-label text-md-end"></label>
                                <div class="col-md-4">
                                    <input type="time" asp-for="StartingTime" class="form-control" />
                                </div>

                                <label asp-for="ClosingTime" class="col-md-2 col-form-label text-md-end"></label>
                                <div class="col-md-4">
                                    <input type="time" asp-for="ClosingTime" class="form-control" />
                                </div>
                            </div>
                            <div class="row mb-2">
                                <label asp-for="LateTime" class="col-md-2 col-form-label text-md-end"></label>
                                <div class="col-md-4">
                                    <input type="time" asp-for="LateTime" class="form-control" />
                                </div>

                                <label asp-for="Banner" class="col-md-2 col-form-label text-md-end"></label>
                                <div class="col-md-4">
                                    <input type="hidden" asp-for="Banner" />
                                    <input type="file" name="banner" class="form-control" id="BannerId" />

                                    <div id="newBannerDiv" class="mt-2" style="display:none">
                                        <img class="img-fluid" id="sBannerId" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="Banner" style="height:100px;" />
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <label asp-for="Logo" class="col-md-2 col-form-label text-md-end"></label>
                                <div class="col-md-4">
                                    <input hidden asp-for="Logo" />
                                    <input type="file" name="logo" class="form-control" id="inputGroupFile02" />
                                    <div id="newLogoDiv" class="mt-2" style="display:none">
                                        <img class="img-fluid" id="sLogoId" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="Logo" style="height:100px;" />
                                    </div>
                                </div>

                                <label asp-for="FavIcon" class="col-md-2 col-form-label text-md-end"></label>
                                <div class="col-md-4">
                                    <input asp-for="FavIcon" type="hidden" />
                                    <input type="file" accept="ico/png" name="fav_Icon" id="fav_Icon" class="form-control" />
                                    <div id="fav_Icon_Div" class="mt-2" style="display:none">
                                        <img class="img-fluid" id="fav_IconId" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="Favicon" style="height:100px;" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer text-center">
                            <button type="submit" id="editButton" class="btn-sm btn-navy-blue" title="Update" data-bs-toggle="tooltip" data-bs-placement="right"><i class="fa fa-edit"></i> Update</button>
                            <button type="button" class="btn-sm btn btn-secondary" data-bs-dismiss="modal"> Close</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/js/AlertifyNotify/AlertifyNofify.js"></script>
    <script>
        let deleted = '@TempData["deleted"]';
        let created = '@TempData["created"]';
        let updated = '@TempData["updated"]';
        let failed = '@TempData["error"]';
  
        function readURL(input, idName) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();

                reader.onload = function (e) {
                    $(idName).attr('src', e.target.result);
                }

                reader.readAsDataURL(input.files[0]); // convert to base64 string
            }
        }

        $("#BannerId").change(function () {
            $("#newBannerDiv").show();
            $("#existingBannerDiv").hide();
            let imgId = "#sBannerId";
            readURL(this, imgId);
        });

        $("#fav_Icon").change(function () {
            $("#fav_Icon_Div").show();
            //$("#existingBannerDiv").hide();
            let imgId = "#fav_IconId";
            readURL(this, imgId);
        });

        $("#inputGroupFile02").change(function () {
            $("#newLogoDiv").show();
            $("#existingLogoDiv").hide();
            let imgId = "#sLogoId";
            readURL(this, imgId);
        });

        // Populate the shared Edit-link modal from the clicked row's data-* attributes.
        $(".edit-link-btn").on("click", function () {
            var b = $(this);
            $("#editLinkId").val(b.data("id"));
            $("#editLinkTitle").val(b.data("title"));
            $("#editLinkType").val(b.data("type"));
            $("#editLinkUrl").val(b.data("url"));
            $("#editLinkOrder").val(b.data("order"));
            $("#editIsActive").prop("checked", b.data("active") === true || b.data("active") === "true");
            new bootstrap.Modal(document.getElementById("editLinkModal")).show();
        });
    </script>
}