@model SMS_App.ViewModels.AdministrationVM.OTPVM

@{
    ViewBag.Title = "Verify OTP";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";

    // Where the code went (set by ForgotPassword on the redirect; absent after a wrong code).
    var channel = TempData["OtpChannel"] as string;
    var sentTo = channel == "SMS" ? "to your registered phone"
               : channel == "Email" ? "to your email address"
               : "to you";
}

@section Styles {
    <style>
        .otp-panel { color: #fff; text-align: center; }
        .otp-panel .otp-icon {
            width: 56px; height: 56px; margin: 0 auto 12px; border-radius: 50%;
            background: rgba(255, 255, 255, .15); display: flex; align-items: center; justify-content: center;
        }
        .otp-panel h1 { font-size: 1.35rem; font-weight: 600; margin-bottom: 6px; }
        .otp-panel .otp-help { font-size: .9rem; color: rgba(255, 255, 255, .85); margin-bottom: 20px; }
        .otp-panel .otp-input {
            height: 56px; font-size: 1.6rem; font-weight: 600; text-align: center;
            letter-spacing: .5em; padding-left: .5em; /* keeps the spaced digits visually centred */
            border-radius: 8px; border: 2px solid transparent;
        }
        .otp-panel .otp-input:focus { border-color: #5bc0de; box-shadow: 0 0 0 .2rem rgba(91, 192, 222, .35); }
        .otp-panel .otp-input.is-invalid { border-color: #f8a5a5; }
        .otp-panel .otp-input::placeholder { color: #c4ccd4; letter-spacing: .5em; font-weight: 400; }
        .otp-panel .btn-verify { height: 48px; font-weight: 600; border-radius: 8px; margin-top: 14px; }
        .otp-panel .otp-error {
            background: rgba(220, 53, 69, .9); color: #fff; border-radius: 6px;
            padding: 8px 12px; font-size: .9rem; margin-bottom: 14px;
        }
        .otp-panel .otp-links { margin-top: 18px; font-size: .9rem; }
        .otp-panel .otp-links a { color: #cfe8ff; text-decoration: none; }
        .otp-panel .otp-links a:hover { text-decoration: underline; }
    </style>
}

<div class="otp-panel">
    <div class="otp-icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="11" width="14" height="10" rx="2"></rect>
            <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
        </svg>
    </div>
    <h1>Enter verification code</h1>
    <p class="otp-help">We sent a 6-digit code @sentTo.</p>

    @if (ViewBag.msg != null)
    {
        <div class="otp-error" role="alert">@ViewBag.msg. Please check the code and try again.</div>
    }

    <form asp-action="OTPGenerate" asp-controller="Accounts" method="post" id="otpForm" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-warning small"></div>

        <label for="OTP" class="sr-only">Verification code</label>
        <input type="text" id="OTP" name="OTP"
               class="form-control otp-input @(ViewBag.msg != null ? "is-invalid" : "")"
               inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}"
               placeholder="••••••" aria-describedby="otpHint" required autofocus />
        <span asp-validation-for="OTP" class="text-warning small d-block mt-1"></span>
        <small id="otpHint" class="sr-only">6 digits</small>

        <button type="submit" id="otpSubmit" class="btn btn-info btn-verify w-100 text-white" disabled>Verify</button>
    </form>

    <div class="otp-links">
        <div>Didn't get the code? <a asp-action="ForgotPassword" asp-controller="Accounts">Send a new code</a></div>
        <div class="mt-2"><a asp-action="Login" asp-controller="Accounts">&larr; Back to Login</a></div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('OTP');
            var button = document.getElementById('otpSubmit');
            var form = document.getElementById('otpForm');

            function sync() {
                // Digits only (also cleans pasted codes like "123 456").
                var digits = input.value.replace(/\D/g, '').slice(0, 6);
                if (input.value !== digits) input.value = digits;
                button.disabled = digits.length !== 6;
                if (digits.length) input.classList.remove('is-invalid');
            }

            input.addEventListener('input', sync);
            form.addEventListener('submit', function (e) {
                if (input.value.length !== 6) { e.preventDefault(); input.focus(); return; }
                button.disabled = true;
                button.textContent = 'Verifying…';
            });
            sync();
        })();
    </script>
}
