@model IEnumerable<SMS.Entities.ApplicationUser>
@{
    ViewBag.Title = "User List";
    GlobalUI.PageTitle = "All User List";

    int sl = 0;
    string userType = "";
}
@if (ViewBag.msg != null)
{
    <span class="alert alert-warning msg">@ViewBag.msg</span>

}
@if (Model != null)
{
    <div>
        <table class="table table-responsive-sm" id="myTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th>User</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>User Type</th>
                    <th>RefId</th>

                    <th>
                        <a class="p-2 btn-sm btn-info rounded-pill" asp-action="Register"><i class="fa fa-plus"></i> Add</a>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@(++sl)</td>
                        <td>@item.UserName</td>
                        <td>@item.PhoneNumber</td>
                        <td>@item.Email</td>
                        @{
                            userType = item.UserType == 's' ? "Student" : item.UserType == 'e' ? "Employee" : "Other";                            
                           }
                        <td>@userType</td>
                        <td>@item.ReferenceId</td>
                        <td>
                            <a class="btn btn-sm btn-warning rounded mr-1" asp-action="EditUser" asp-route-id="@item.Id" data-toggle="tooltip" data-placement="top" title="Edit"><i class="fa fa-edit"></i> </a>
                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <a class="btn btn-sm rounded btn-info mr-1" asp-action="Impersonate" asp-route-id="@item.Id" data-toggle="tooltip" data-placement="top" title="Login as this user for testing"><i class="fa fa-user-secret"></i> </a>
                            }
                            <a class="btn btn-sm rounded btn-danger" asp-action="DeleteUser" asp-route-id="@item.Id" data-toggle="tooltip" data-placement="right" title="Delete"><i class="fa fa-trash"></i> </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

}


@section Scripts{
    <script src="~/js/DataTable/dataTable.js"></script>
<script>
    $(document).ready(function () {
        $('.msg').fadeOut(6000);
    });
</script>
            }