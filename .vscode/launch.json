{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SMS_App (Launch)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/SMS_App/bin/Debug/net8.0/SMS_App.dll",
      "args": [],
      "cwd": "${workspaceFolder}/SMS_App",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/SMS_App/Views"
      }
    }
  ]
}
