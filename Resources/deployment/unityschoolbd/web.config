<?xml version="1.0" encoding="utf-8"?>
<!--
  Production web.config for EIMS on Plesk Windows shared hosting (IIS).
  Written for the SELF-CONTAINED win-x64 publish produced by publish-windows.sh.
  The file is regenerated by `dotnet publish`, so re-apply stdoutLog / environment
  settings after every publish, or keep a copy on the server and overwrite.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore
          processPath=".\SMS_App.exe"
          arguments=""
          stdoutLogEnabled="true"
          stdoutLogFile=".\logs\stdout"
          hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- Override the AES key/IV only if you do NOT want the default "1234567890123456".
               If you set these, they MUST match the key used to encrypt the connection string. -->
          <!-- <environmentVariable name="AES_KEY" value="CHANGE_ME" /> -->
          <!-- <environmentVariable name="AES_IV" value="CHANGE_ME" /> -->
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>