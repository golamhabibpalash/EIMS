# Environment for the multi-tenant SchoolBD instance (systemd EnvironmentFile=, chmod 600, owner root).
# Never commit real values. appsettings.json is left untouched by deploys, these override it.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5100

# Turn the instance into the multi-tenant platform.
MultiTenancy__Enabled=true
MultiTenancy__PlatformRootDomain=schoolbd.net
# Per-school files: {StorageRoot}/{tenantCode}/wwwroot/... and .../AdmissionFiles. Must be writable by the app user.
MultiTenancy__StorageRoot=/var/lib/schoolbd/tenants
MultiTenancy__ResolutionCacheSeconds=60

# SchoolBD_PlatformDB (tenant registry). SqlServer or PostgreSQL.
MultiTenancy__Platform__Provider=PostgreSQL
MultiTenancy__Platform__ConnectionString=Host=127.0.0.1;Port=5432;Database=SchoolBD_PlatformDB;Username=schoolbd_platform;Password=CHANGE_ME

# Master key that encrypts every school's database password in PlatformSecrets.
# Generate once: openssl rand -base64 32. Back it up offline: without it no school database can be opened.
SCHOOLBD_SECRETS_KEY=CHANGE_ME_BASE64_32_BYTES

# Mobile API signing key (>= 32 chars). Shared by all schools; tokens are bound to their school by a claim.
Jwt__Key=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
Jwt__Issuer=EIMS
Jwt__Audience=EIMS.Mobile

# Hangfire is not supported in multi-tenant mode yet (Phase B); it is forced off.
Hangfire__IsEnabled=false
